{
  "name": "meetops-ai",
  "private": true,
  "version": "0.0.0",
  "description": "MeetOps AI monorepo (Phase 0: architecture and foundation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iakash22/meetops-platform"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "^20.19 || >=22.12 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "node scripts/clean.mjs all",
    "clean:turbo": "node scripts/clean.mjs turbo",
    "clean:build": "node scripts/clean.mjs build",
    "clean:cache": "node scripts/clean.mjs cache",
    "clean:modules": "node scripts/clean.mjs modules",
    "clean:data": "node scripts/clean.mjs data",
    "clean:all": "node scripts/clean.mjs full",
    "clean:deep": "node scripts/clean.mjs deep",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=2",
    "size": "turbo run size",
    "coverage": "turbo run coverage --concurrency=1",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@meetops/api",
    "dev:web": "turbo run dev --filter=@meetops/web",
    "dev:worker": "turbo run dev --filter=@meetops/worker",
    "dev:realtime": "turbo run dev --filter=@meetops/realtime",
    "dev:desktop": "turbo run dev --filter=@meetops/desktop",
    "dev:extension": "turbo run dev --filter=@meetops/extension",
    "dev:stack": "node scripts/dev-stack.mjs",
    "test:e2e:smoke": "pnpm --filter @meetops/tests test:e2e:smoke",
    "dev:stack:turbo": "turbo run dev --filter=@meetops/api --filter=@meetops/web --filter=@meetops/worker --log-order=stream",
    "prepare": "husky",
    "postinstall": "turbo run postinstall --cache-dir .turbo",
    "docker:ensure": "node scripts/ensure-docker.mjs",
    "dev:infra:up": "node scripts/ensure-docker.mjs && docker compose --env-file .env -f infra/compose/compose.dev.yml up -d",
    "dev:infra:down": "node scripts/ensure-docker.mjs && docker compose --env-file .env -f infra/compose/compose.dev.yml down",
    "dev:infra:logs": "node scripts/ensure-docker.mjs && docker compose --env-file .env -f infra/compose/compose.dev.yml logs -f",
    "db:generate": "pnpm --filter @meetops/database prisma:generate",
    "db:migrate": "pnpm --filter @meetops/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @meetops/database db:migrate:dev",
    "db:seed": "pnpm --filter @meetops/database db:seed",
    "db:studio": "pnpm --filter @meetops/database db:studio",
    "db:roles": "pnpm --filter @meetops/database db:roles",
    "local-gates": "bash scripts/local-gates",
    "dev:services": "bash scripts/dev-services.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack"
      ],
      "allowedVersions": {
        "react-server-dom-webpack>react": "18",
        "react-server-dom-webpack>react-dom": "18"
      }
    },
    "overrides": {
      "shell-quote@<1.8.4": "^1.8.4",
      "tmp@<0.2.6": "^0.2.6",
      "firefox-profile@4.7.0": "4.7.1",
      "@expo/cli>tar": "^7.5.21",
      "cacache>tar": "^7.5.21",
      "@expo/plist>@xmldom/xmldom": "^0.8.15",
      "@expo/metro-config>postcss": "^8.5.18",
      "node-forge@<1.4.2": "1.4.2",
      "query-string@7>decode-uri-component": "^0.5.1",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "esbuild@<0.28.1": "^0.28.1",
      "image-size@<2.0.3": "^2.0.3",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=9.0.0 <11.0.1": "^11.0.1",
      "uuid@<11.1.1": "^11.1.1"
    },
    "patchedDependencies": {
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch",
      "metro@0.81.5": "patches/metro@0.81.5.patch"
    }
  }
}
