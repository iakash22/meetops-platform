{
  "name": "meetops-ai",
  "private": true,
  "version": "0.0.0",
  "description": "MeetOps AI monorepo (Phase 0: architecture and foundation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iakash22/meetops-platform"
  },
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.19 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "prepare": "husky",
    "postinstall": "turbo run postinstall --cache-dir .turbo",
    "dev:infra:up": "docker compose --env-file .env -f infra/compose/compose.dev.yml up -d",
    "dev:infra:down": "docker compose --env-file .env -f infra/compose/compose.dev.yml down",
    "dev:infra:logs": "docker compose --env-file .env -f infra/compose/compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack"
      ],
      "allowedVersions": {
        "react-server-dom-webpack>react": "18",
        "react-server-dom-webpack>react-dom": "18"
      }
    },
    "overrides": {
      "shell-quote@<1.8.4": "^1.8.4",
      "@expo/cli>tar": "^7.5.21",
      "cacache>tar": "^7.5.21",
      "@expo/plist>@xmldom/xmldom": "^0.8.15",
      "@expo/metro-config>postcss": "^8.5.18"
    },
    "patchedDependencies": {
      "@expo/cli@0.22.28": "patches/@expo__cli@0.22.28.patch"
    }
  }
}
