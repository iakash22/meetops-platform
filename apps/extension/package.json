    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "wxt": "^0.19.13"
  }
}
