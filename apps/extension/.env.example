# Build-time origins for ADR-005 pairing. Copy to .env (or .env.production / .env.development) and edit.
# Values must be bare https origins (no path or trailing slash). localhost is allowed only in dev builds
# (`wxt` / `wxt build --mode development`), where http://localhost:<port> also works.
# Unset or empty values fall back to the defaults below.

# Web app origin hosting the pairing page. Also the ONLY origin in manifest externally_connectable.
WXT_WEB_ORIGIN=https://app.meetops.ai
# API origin. The ONLY origin that receives the extension's bearer token.
WXT_API_ORIGIN=https://api.meetops.ai
