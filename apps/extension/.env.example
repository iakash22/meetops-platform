# Build-time origins for ADR-005 pairing. Copy to .env (or .env.production / .env.development) and edit.
# Values must be bare https origins (no path or trailing slash). localhost is allowed only in dev builds
# (`wxt` / `wxt build --mode development`), where http://localhost:<port> also works.
# Unset or empty values fall back to the defaults below.

# Web app origin hosting the pairing page. Also the ONLY origin in manifest externally_connectable.
WXT_WEB_ORIGIN=https://app.meetops.ai
# API origin. The ONLY origin that receives the extension's bearer token.
WXT_API_ORIGIN=https://api.meetops.ai

# Privacy Policy page. Absolute https URL, or a path resolved against WXT_WEB_ORIGIN.
# The popup and the options page show the link only when this is set. Opening it uses a
# new tab. Production builds (`wxt build`) warn (they do not fail) if it is missing.
# WXT_PRIVACY_URL=https://meetops.ai/privacy

# Feature flag: recording-session HTTP client vs StubUploadClient.
# Unset: on in development builds (`wxt` / `wxt build --mode development`), off in production
# builds (`wxt build`). Tests always use the stub. Set `true`/`1` to force the HTTP client
# (including in a production build); set `false`/`0` to force the stub in dev.
# WXT_FEATURE_HTTP_UPLOAD=true
