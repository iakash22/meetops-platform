    "redis": "^4.7.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
