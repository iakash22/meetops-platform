{
  "name": "@meetops/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx --import ../../scripts/load-env-if-exists.mjs src/run.ts",
    "dev:watch": "tsx watch --import ../../scripts/load-env-if-exists.mjs src/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "media:reconcile": "node dist/scripts/reconcile-media-jobs.js",
    "takeover:redrive": "node dist/scripts/takeover-dlq-redrive.js",
    "takeover:redrive:dev": "tsx --import ../../scripts/load-env-if-exists.mjs src/scripts/takeover-dlq-redrive.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.7.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@meetops/config": "workspace:*",
    "@meetops/contracts": "workspace:*",
    "@meetops/database": "workspace:*",
    "@meetops/integrations": "workspace:*",
    "@meetops/logger": "workspace:*",
    "@meetops/notifications": "workspace:*",
    "@meetops/session-verifier": "workspace:*",
    "@meetops/storage": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.41.1",
    "bullmq": "^5.18.0",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "maxmind": "5.0.7",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "@vitest/coverage-v8": "4.1.12",
    "vitest": "^4.1.12"
  }
}
