# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf).
# Configurable: CSP_API_ORIGIN, CSP_REALTIME_ORIGIN, CSP_STORAGE_ORIGIN (required, validated by
# 10-validate-csp-env.sh before this is rendered), CSP_REPORT_URL (optional CSP report endpoint) and
# CSP_UPGRADE_INSECURE (default on).

# R20: Reporting-Endpoints only when CSP_REPORT_URL is set (nginx skips an add_header whose value is empty).
map "${CSP_REPORT_URL}" $csp_reporting_endpoints {
    ""      "";
    default "csp=\"${CSP_REPORT_URL}\"";
}

# #399 L2: the report-to directive only when CSP_REPORT_URL is set (no dangling `report-to csp` without an endpoint).
map "${CSP_REPORT_URL}" $csp_report_to {
    ""      "";
    default " report-to csp";
}

# R20: upgrade-insecure-requests unless CSP_UPGRADE_INSECURE=off (only the plain-http localhost compose stack sets
# that, because its API/realtime/MinIO origins are http://localhost and would be upgraded to https).
map "${CSP_UPGRADE_INSECURE}" $csp_upgrade_insecure {
    "off"   "";
    default " upgrade-insecure-requests;";
}

# R23: hashed Vite assets are immutable; index.html, the SPA fallback and everything else is never cached.
map $uri $web_cache_control {
    ~^/assets/ "public, max-age=31536000, immutable";
    default    "no-store";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # style-src hash: the inline <style> in apps/web/index.html (`:root { color-scheme: dark; }`, avoids a white
    # flash before the CSS bundle loads). scripts/check-csp.mjs recomputes every inline hash and fails the web
    # build test on a missing or stale (unused) hash, so update both together.
    # Security headers. Only set at server level: an add_header inside a location
    # would drop all of these, so caching is a server-level map on $uri.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-fwWCgm+4FJQM5Um+NEFPPThRM/ATS1CrMQ0Jv1SN3fs='; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${CSP_API_ORIGIN} ${CSP_REALTIME_ORIGIN} ${CSP_STORAGE_ORIGIN}; media-src 'self' blob: ${CSP_STORAGE_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';$csp_upgrade_insecure$csp_report_to" always;
    add_header Reporting-Endpoints $csp_reporting_endpoints always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    # R21: HSTS here as well as at the TLS terminator (browsers ignore it over plain http, so local runs are fine).
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Cache-Control $web_cache_control always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite hashed assets (Cache-Control from $web_cache_control above).
    location /assets/ {
        try_files $uri =404;
    }

    # SPA fallback for TanStack Router client-side routes ($uri becomes /index.html: no-store).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
