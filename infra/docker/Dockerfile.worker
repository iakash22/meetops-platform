# syntax=docker/dockerfile:1.7
# MeetOps AI — background worker (@meetops/worker, apps/worker; BullMQ on Redis).
# Includes FFmpeg + ffprobe + libopus (pinned) for media processing. Build context: repository root.
#   docker build -f infra/docker/Dockerfile.worker -t meetops/worker .
ARG NODE_VERSION=20.20.2

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@9.12.3 --activate
WORKDIR /repo
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

FROM base AS build
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
# Generate the Prisma client (@meetops/database) in the build stage. The root
# postinstall is skipped by --ignore-scripts, so run it explicitly.
RUN pnpm --filter @meetops/database exec prisma generate \
 && pnpm --filter "@meetops/worker..." run build
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm --filter @meetops/worker deploy --prod --ignore-scripts /out
# pnpm deploy re-links node_modules, so regenerate the client inside the deployed
# output when the app depends on @meetops/database (no-op otherwise).
RUN set -e; \
    schema="$(find /out/node_modules -path '*@meetops/database/prisma/schema.prisma' -print -quit 2>/dev/null || true)"; \
    if [ -n "$schema" ]; then \
      /repo/packages/database/node_modules/.bin/prisma generate --schema "$schema"; \
    fi

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
# FFmpeg is pinned to the exact Debian bookworm(-security) build; bump deliberately
# when Debian ships a fix (see docs/12-security: pinned, patched FFmpeg).
# OpenSSL is required by the Prisma query engine.
ARG FFMPEG_VERSION=7:5.1.9-0+deb12u1
# Opus codec (libavcodec59 links it); pinned bookworm build.
ARG LIBOPUS_VERSION=1.3.1-3
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends "ffmpeg=${FFMPEG_VERSION}" "libopus0=${LIBOPUS_VERSION}" tini openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    MEDIA_TMP_DIR=/tmp/work
# Writable FFmpeg scratch dir (mounted as tmpfs in compose; root FS is read-only).
RUN mkdir -p /tmp/work && chown node:node /tmp/work && chmod 0700 /tmp/work \
 && ffmpeg -hide_banner -version >/dev/null \
 && ffprobe -hide_banner -version >/dev/null \
 && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q libopus \
 && ffmpeg -hide_banner -decoders 2>/dev/null | grep -q libopus
WORKDIR /app
COPY --from=build --chown=node:node /out ./
USER node
# The worker exposes no HTTP endpoint yet; liveness is the node process itself
# (tini forwards SIGTERM so BullMQ shuts down gracefully).
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
