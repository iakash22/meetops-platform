{
  "name": "@meetops/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000",
    "test:api": "vitest run --project api",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project factories --project contract --project api --project security",
    "test:e2e": "playwright test -c e2e/playwright.config.ts && playwright test -c e2e/flow/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "test:security": "vitest run --project security",
    "test:e2e:flow": "playwright test -c e2e/flow/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c e2e/web-smoke/playwright.config.ts"
  },
  "devDependencies": {
    "@meetops/api": "workspace:*",
    "@meetops/contracts": "workspace:*",
    "@playwright/test": "1.64.1",
    "@sinclair/typebox": "^0.34.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/pg": "^8.11.10",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "testcontainers": "^11.14.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
