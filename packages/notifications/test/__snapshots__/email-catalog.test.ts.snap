esentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;"><a href="https://app.meetops.test/forgot-password" target="_blank" rel="noopener" style="display:inline-block;min-height:44px;line-height:44px;padding:0 24px;font-size:16px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Reset password</a></td></tr></table><p class="mo-muted" style="margin:0 0 16px;color:#A3A3A3;font-size:13px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:<br><a class="mo-link" href="https://app.meetops.test/forgot-password" style="color:#3AB0E0;text-decoration:underline;word-break:break-all;">https://app.meetops.test/forgot-password</a></p></td></tr><tr><td style="padding:20px 8px 0;"><p class="mo-muted" style="margin:0 0 8px;color:#A3A3A3;font-size:12px;line-height:1.5;">You&#39;re receiving this security email because of activity on your MeetOps account. It can&#39;t be turned off.</p><p class="mo-muted" style="margin:0;color:#A3A3A3;font-size:12px;">&copy; MeetOps</p></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > password-changed > matches html and text snapshots > subject 1`] = `"Your MeetOps password was changed"`;

exports[`email catalog > password-changed > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

The password for your MeetOps account was changed on 26 Oct 2026, 11:40 PM IST. Other sessions have been signed out.

If you didn't change it, reset your password now and contact your workspace admin.

Reset password: https://app.meetops.test/forgot-password

--
You're receiving this security email because of activity on your MeetOps account. It can't be turned off.
"
`;

