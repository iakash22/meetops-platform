nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="mo-bg" width="100%" bgcolor="#0A0A0A" style="background-color:#0A0A0A;"><tr><td align="center" style="padding:40px 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="mo-container" width="600" style="width:600px;max-width:600px;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><tr><td style="padding:0 4px 24px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="36" style="width:36px;"><img src="cid:meetops-logo@meetops" width="36" height="36" alt="MeetOps AI" style="display:block;width:36px;height:36px;border:0;outline:none;text-decoration:none;border-radius:9px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:12px;color:#F5F5F7;font-size:19px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td class="mo-surface" bgcolor="#141416" style="background-color:#141416;border:1px solid #2A2A2E;border-radius:16px;overflow:hidden;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td><div style="background-color:#0D0D10;border-bottom:1px solid #2A2A2E;border-radius:16px 16px 0 0;overflow:hidden;"><!--[if gte mso 9]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;"><v:fill type="gradient" color="#0D0D10" color2="#0B2531" angle="135"/><v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0"><![endif]--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#0D0D10" style="background-color:#0D0D10;"><tr><td style="padding:28px 40px 8px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td valign="middle" style="width:8px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="8"><tr><td width="8" height="8" bgcolor="#FF2D95" style="width:8px;height:8px;max-height:8px;background-color:#FF2D95;border-radius:50%;font-size:1px;line-height:8px;mso-line-height-rule:exactly;">&#8203;</td></tr></table></td><td style="padding-left:10px;color:#F5F5F7;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">MeetOps AI &middot; Security</td></tr></table><p style="margin:6px 0 0;color:#A1A1AA;font-size:13px;line-height:18px;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Meeting to action</p></td></tr><tr><td style="font-size:0;line-height:0;"><!--[if !mso]><!--><img src="cid:meetops-banner@meetops" width="600" height="76" alt="Animated MeetOps AI feature icons: record, transcribe, AI summary, tasks and sync" style="display:block;width:100%;max-width:600px;height:auto;border:0;outline:none;text-decoration:none;background-color:#0D0D10;color:#A1A1AA;font-size:12px;line-height:1.5;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><!--<![endif]--><!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600"><tr><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#9679;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#8767;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#10022;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#9745;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#10227;</td></tr></table></td></tr></table><![endif]--></td></tr><tr><td><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Record</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Transcribe</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">AI summary</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Tasks</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Sync</td></tr></table></td></tr></table><!--[if gte mso 9]></v:textbox></v:rect><![endif]--></div></td></tr><tr><td class="mo-pad" style="padding:40px 40px 32px;"><p class="mo-link" style="margin:0 0 12px;color:#3AB0E0;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;"><span style="display:inline-block;width:8px;height:8px;margin:0 8px 1px 0;border-radius:50%;background-color:#FF2D95;vertical-align:middle;"></span>Security</p><h1 class="mo-text mo-h1" style="margin:0 0 16px;font-size:28px;line-height:1.2;letter-spacing:-0.02em;font-weight:700;color:#F5F5F7;">Your MeetOps password was changed</h1><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Hi Ana,</p><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">The password for your MeetOps account was changed on 26 Oct 2026, 11:40 PM IST. Other sessions have been signed out.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px;border-collapse:separate;"><tr><td class="mo-surface" bgcolor="#2A1215" style="background-color:#2A1215;padding:18px 20px;border:1px solid #2A2A2E;border-left:3px solid #EF4444;border-radius:12px;"><p class="mo-text" style="margin:0 0 0px;color:#F5F5F7;font-size:15px;font-weight:400;line-height:1.6;">If you didn&#39;t change it, reset your password now and contact your workspace admin.</p></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 28px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;border:1px solid #3AB0E0;"><a href="https://app.meetops.test/forgot-password" target="_blank" rel="noopener" style="display:inline-block;min-height:46px;line-height:46px;padding:0 28px;font-size:15px;font-weight:600;letter-spacing:0.01em;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Reset password&nbsp;&rarr;</a></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 8px;border-top:1px solid #2A2A2E;"><tr><td style="padding-top:20px;"><p class="mo-muted" style="margin:0 0 6px;color:#A1A1AA;font-size:12px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:</p><a class="mo-link" href="https://app.meetops.test/forgot-password" style="color:#3AB0E0;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.6;text-decoration:underline;word-break:break-all;">https://app.meetops.test/forgot-password</a></td></tr></table></td></tr></table></td></tr><tr><td style="padding:28px 4px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding-bottom:16px;border-bottom:1px solid #2A2A2E;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="22" style="width:22px;"><img src="cid:meetops-logo@meetops" width="22" height="22" alt="MeetOps AI" style="display:block;width:22px;height:22px;border:0;outline:none;text-decoration:none;border-radius:6px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:8px;color:#F5F5F7;font-size:14px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td style="padding-top:16px;"><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">MeetOps AI turns meetings into reviewed, synced tasks.</p><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">You&#39;re receiving this security email because of activity on your MeetOps account. It can&#39;t be turned off.</p><p class="mo-muted" style="margin:0;color:#A1A1AA;font-size:12px;">&copy; MeetOps AI</p></td></tr></table></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > password-changed > matches html and text snapshots > subject 1`] = `"Your MeetOps password was changed"`;

exports[`email catalog > password-changed > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

The password for your MeetOps account was changed on 26 Oct 2026, 11:40 PM IST. Other sessions have been signed out.

If you didn't change it, reset your password now and contact your workspace admin.

Reset password: https://app.meetops.test/forgot-password

--
You're receiving this security email because of activity on your MeetOps account. It can't be turned off.
"
`;

exports[`email catalog > password-reset > matches html and text snapshots > html 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>Reset your password</title><style>@media (prefers-color-scheme: light){.mo-bg{background-color:#FFFFFF!important}.mo-surface{background-color:#F5F5F7!important;border-color:#D4D4D8!important}.mo-text{color:#111113!important}.mo-muted{color:#52525B!important}.mo-link{color:#005F82!important}}[data-ogsc] .mo-text{color:#111113!important}@media only screen and (max-width:620px){.mo-container{width:100%!important}.mo-pad{padding:28px 22px!important}.mo-h1{font-size:24px!important}}</style></head><body class="mo-bg" style="margin:0;padding:0;background-color:#0A0A0A;-webkit-text-size-adjust:100%;"><div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0A0A0A;">Use this link to choose a new MeetOps password.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&