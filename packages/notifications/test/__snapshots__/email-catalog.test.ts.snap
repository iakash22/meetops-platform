anscribe</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">AI summary</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Tasks</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Sync</td></tr></table></td></tr></table><!--[if gte mso 9]></v:textbox></v:rect><![endif]--></div></td></tr><tr><td class="mo-pad" style="padding:40px 40px 32px;"><p class="mo-link" style="margin:0 0 12px;color:#3AB0E0;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;"><span style="display:inline-block;width:8px;height:8px;margin:0 8px 1px 0;border-radius:50%;background-color:#FF2D95;vertical-align:middle;"></span>Security</p><h1 class="mo-text mo-h1" style="margin:0 0 16px;font-size:28px;line-height:1.2;letter-spacing:-0.02em;font-weight:700;color:#F5F5F7;">Reset your password</h1><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Hi Ana,</p><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">We received a request to reset the password for your MeetOps account.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 28px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;border:1px solid #3AB0E0;"><a href="https://app.meetops.test/reset-password?token=demo" target="_blank" rel="noopener" style="display:inline-block;min-height:46px;line-height:46px;padding:0 28px;font-size:15px;font-weight:600;letter-spacing:0.01em;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Reset password&nbsp;&rarr;</a></td></tr></table><p class="mo-muted" style="margin:0 0 16px;color:#A1A1AA;font-size:15px;line-height:1.65;">This link expires in 30 minutes and can be used once.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 8px;border-top:1px solid #2A2A2E;"><tr><td style="padding-top:20px;"><p class="mo-muted" style="margin:0 0 6px;color:#A1A1AA;font-size:12px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:</p><a class="mo-link" href="https://app.meetops.test/reset-password?token=demo" style="color:#3AB0E0;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.6;text-decoration:underline;word-break:break-all;">https://app.meetops.test/reset-password?token=demo</a></td></tr></table><p class="mo-muted" style="margin:0 0 16px;color:#A1A1AA;font-size:13px;line-height:1.65;">If you didn&#39;t ask for this, you can ignore this email. Your password won&#39;t change.</p></td></tr></table></td></tr><tr><td style="padding:28px 4px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding-bottom:16px;border-bottom:1px solid #2A2A2E;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="22" style="width:22px;"><img src="cid:meetops-logo@meetops" width="22" height="22" alt="MeetOps AI" style="display:block;width:22px;height:22px;border:0;outline:none;text-decoration:none;border-radius:6px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:8px;color:#F5F5F7;font-size:14px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td style="padding-top:16px;"><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">MeetOps AI turns meetings into reviewed, synced tasks.</p><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">You&#39;re receiving this security email because of activity on your MeetOps account. It can&#39;t be turned off.</p><p class="mo-muted" style="margin:0;color:#A1A1AA;font-size:12px;">&copy; MeetOps AI</p></td></tr></table></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > password-reset > matches html and text snapshots > subject 1`] = `"Reset your password"`;

exports[`email catalog > password-reset > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

We received a request to reset the password for your MeetOps account.

Reset password: https://app.meetops.test/reset-password?token=demo

This link expires in 30 minutes and can be used once.

If you didn't ask for this, you can ignore this email. Your password won't change.

--
You're receiving this security email because of activity on your MeetOps account. It can't be turned off.
"
`;

