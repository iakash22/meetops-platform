exports[`email catalog > tasks-ready-for-review > matches html and text snapshots > html 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>6 tasks ready for review: Weekly product sync</title><style>@media (prefers-color-scheme: light){.mo-bg{background-color:#FFFFFF!important}.mo-surface{background-color:#F5F5F5!important;border-color:#D4D4D4!important}.mo-text{color:#111111!important}.mo-muted{color:#525252!important}.mo-link{color:#005F82!important}}[data-ogsc] .mo-text{color:#111111!important}@media only screen and (max-width:620px){.mo-container{width:100%!important}.mo-pad{padding:24px 20px!important}}</style></head><body class="mo-bg" style="margin:0;padding:0;background-color:#0A0A0A;-webkit-text-size-adjust:100%;"><div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0A0A0A;">6 extracted tasks are waiting for your approval.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" class="mo-bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0A0A0A" style="background-color:#0A0A0A;"><tr><td align="center" style="padding:32px 12px;"><table role="presentation" class="mo-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><tr><td style="padding:0 8px 20px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="12" height="12" bgcolor="#007BA7" style="width:12px;height:12px;background-color:#007BA7;border-radius:3px;font-size:0;line-height:0;">&nbsp;</td><td class="mo-text" style="padding-left:10px;color:#EDEDED;font-size:18px;font-weight:700;letter-spacing:0.2px;">MeetOps</td></tr></table></td></tr><tr><td class="mo-surface mo-pad" bgcolor="#141414" style="background-color:#141414;border:1px solid #262626;border-top:3px solid #007BA7;border-radius:12px;padding:32px;"><h1 class="mo-text" style="margin:0 0 12px;color:#EDEDED;font-size:22px;line-height:1.3;font-weight:600;">6 tasks ready for review: Weekly product sync</h1><p class="mo-text" style="margin:0 0 16px;color:#EDEDED;font-size:16px;line-height:1.6;">Hi Ana,</p><p class="mo-text" style="margin:0 0 16px;color:#EDEDED;font-size:16px;line-height:1.6;">We extracted 6 tasks from Weekly product sync. Review them before they&#39;re sent to GitHub or Jira.</p><ul style="margin:0 0 20px;padding:0 0 0 20px;"><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">Ship upload queue</li><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">Review ADR-012</li><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">Fix flaky members test</li><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">Bump nodemailer</li><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">Write runbook</li><li class="mo-text" style="margin:0 0 8px;color:#EDEDED;font-size:15px;line-height:1.5;">…and 1 more</li></ul><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;"><a href="https://app.meetops.test/meetings/m1/tasks/review" target="_blank" rel="noopener" style="display:inline-block;min-height:44px;line-height:44px;padding:0 24px;font-size:16px;font-weight:600;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Review tasks</a></td></tr></table><p class="mo-muted" style="margin:0 0 16px;color:#A3A3A3;font-size:13px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:<br><a class="mo-link" href="https://app.meetops.test/meetings/m1/tasks/review" style="color:#3AB0E0;text-decoration:underline;word-break:break-all;">https://app.meetops.test/meetings/m1/tasks/review</a></p></td></tr><tr><td style="padding:20px 8px 0;"><p class="mo-muted" style="margin:0 0 8px;color:#A3A3A3;font-size:12px;line-height:1.5;">You&#39;re receiving this because of your MeetOps notification settings.</p><p class="mo-muted" style="margin:0 0 8px;color:#A3A3A3;font-size:12px;line-height:1.5;"><a class="mo-link" href="https://app.meetops.test/settings/notifications" style="color:#3AB0E0;text-decoration:underline;">Manage email preferences</a> &middot; <a class="mo-link" href="https://app.meetops.test/u/one-click?t=demo" style="color:#3AB0E0;text-decoration:underline;">Unsubscribe</a></p><p class="mo-muted" style="margin:0;color:#A3A3A3;font-size:12px;">&copy; MeetOps</p></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > tasks-ready-for-review > matches html and text snapshots > subject 1`] = `"6 tasks ready for review: Weekly product sync"`;

exports[`email catalog > tasks-ready-for-review > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

We extracted 6 tasks from Weekly product sync. Review them before they're sent to GitHub or Jira.

- Ship upload queue
- Review ADR-012
- Fix flaky members test
- Bump nodemailer
- Write runbook
- …and 1 more

Review tasks: https://app.meetops.test/meetings/m1/tasks/review

--
You're receiving this because of your MeetOps notification settings.
Manage email preferences: https://app.meetops.test/settings/notifications
Unsubscribe: https://app.meetops.test/u/one-click?t=demo
"
`;

exports[`email catalog > verification > matches html and text snapshots > html 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>Verify your email address</title><style>@media (prefers-color-scheme: light){.mo-bg{background-color:#FFFFFF!important}.mo-surface{background-color:#F5F5F5!important;border-color:#D4D4D4!important}.mo-text{color:#111111!important}.mo-muted{color:#525252!important}.mo-link{color:#005F82!important}}[data-ogsc] .mo-text{color:#111111!important}@media only screen and (max-width:620px){.mo-container{width:100%!important}.mo-pad{padding:24px 20px!important}}</style></head><body class="mo-bg" style="margin:0;padding:0;background-color:#0A0A0A;-webkit-text-size-adjust:100%;"><div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0A0A0A;">Confirm your email to finish setting up MeetOps.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" class="mo-bg" width="100%