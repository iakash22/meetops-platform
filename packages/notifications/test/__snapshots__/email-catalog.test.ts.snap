p class="mo-muted" style="margin:0 0 16px;color:#A3A3A3;font-size:13px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:<br><a class="mo-link" href="https://app.meetops.test/verify-email?token=demo" style="color:#3AB0E0;text-decoration:underline;word-break:break-all;">https://app.meetops.test/verify-email?token=demo</a></p><p class="mo-muted" style="margin:0 0 16px;color:#A3A3A3;font-size:13px;line-height:1.6;">If you didn&#39;t create a MeetOps account, you can ignore this email.</p></td></tr><tr><td style="padding:20px 8px 0;"><p class="mo-muted" style="margin:0 0 8px;color:#A3A3A3;font-size:12px;line-height:1.5;">You&#39;re receiving this security email because of activity on your MeetOps account. It can&#39;t be turned off.</p><p class="mo-muted" style="margin:0;color:#A3A3A3;font-size:12px;">&copy; MeetOps</p></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > verification > matches html and text snapshots > subject 1`] = `"Verify your email address"`;

exports[`email catalog > verification > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

Confirm this is your email address to finish setting up your MeetOps account.

Verify email: https://app.meetops.test/verify-email?token=demo

This link expires in 24 hours.

If you didn't create a MeetOps account, you can ignore this email.

--
You're receiving this security email because of activity on your MeetOps account. It can't be turned off.
"
`;
