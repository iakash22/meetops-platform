if;">Transcribe</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">AI summary</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Tasks</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Sync</td></tr></table></td></tr></table><!--[if gte mso 9]></v:textbox></v:rect><![endif]--></div></td></tr><tr><td class="mo-pad" style="padding:40px 40px 32px;"><p class="mo-link" style="margin:0 0 12px;color:#3AB0E0;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;"><span style="display:inline-block;width:8px;height:8px;margin:0 8px 1px 0;border-radius:50%;background-color:#FF2D95;vertical-align:middle;"></span>Security</p><h1 class="mo-text mo-h1" style="margin:0 0 16px;font-size:28px;line-height:1.2;letter-spacing:-0.02em;font-weight:700;color:#F5F5F7;">Sign-in temporarily locked</h1><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Hi Ana,</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px;border-collapse:separate;"><tr><td class="mo-surface" bgcolor="#2A1215" style="background-color:#2A1215;padding:18px 20px;border:1px solid #2A2A2E;border-left:3px solid #EF4444;border-radius:12px;"><p class="mo-text" style="margin:0 0 0px;color:#F5F5F7;font-size:15px;font-weight:400;line-height:1.6;">We locked sign-in to your account for 15 minutes after several failed attempts.</p></td></tr></table><p class="mo-tex