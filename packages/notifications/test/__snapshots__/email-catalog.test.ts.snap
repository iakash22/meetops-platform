h:8px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="8"><tr><td width="8" height="8" bgcolor="#FF2D95" style="width:8px;height:8px;max-height:8px;background-color:#FF2D95;border-radius:50%;font-size:1px;line-height:8px;mso-line-height-rule:exactly;">&#8203;</td></tr></table></td><td style="padding-left:10px;color:#F5F5F7;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">MeetOps AI &middot; Security</td></tr></table><p style="margin:6px 0 0;color:#A1A1AA;font-size:13px;line-height:18px;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Meeting to action</p></td></tr><tr><td style="font-size:0;line-height:0;"><!--[if !mso]><!--><img src="cid:meetops-banner@meetops" width="600" height="76" alt="Animated MeetOps AI feature icons: record, transcribe, AI summary, tasks and sync" style="display:block;width:100%;max-width:600px;height:auto;border:0;outline:none;text-decoration:none;background-color:#0D0D10;color:#A1A1AA;font-size:12px;line-height:1.5;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><!--<![endif]--><!--[if mso]><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600"><tr><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#9679;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#8767;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#10022;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#9745;</td></tr></table></td><td width="120" align="center" style="padding:16px 0 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="44" height="44" align="center" valign="middle" bgcolor="#10232C" style="width:44px;height:44px;background-color:#10232C;border:1px solid #1B3A48;color:#4F7D90;font-size:18px;font-family:Segoe UI Symbol,Arial,sans-serif;">&#10227;</td></tr></table></td></tr></table><![endif]--></td></tr><tr><td><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Record</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Transcribe</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">AI summary</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Tasks</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Sync</td></tr></table></td></tr></table><!--[if gte mso 9]></v:textbox></v:rect><![endif]--></div></td></tr><tr><td class="mo-pad" style="padding:40px 40px 32px;"><p class="mo-link" style="margin:0 0 12px;color:#3AB0E0;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;"><span style="display:inline-block;width:8px;height:8px;margin:0 8px 1px 0;border-radius:50%;background-color:#FF2D95;vertical-align:middle;"></span>Security</p><h1 class="mo-text mo-h1" style="margin:0 0 16px;font-size:28px;line-height:1.2;letter-spacing:-0.02em;font-weight:700;color:#F5F5F7;">You already have a MeetOps account</h1><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Hi there,</p><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Someone tried to sign up with this email address, but it already has a MeetOps account. If that was you, sign in or reset your password.</p><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 28px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;border:1px solid #3AB0E0;"><a href="https://app.meetops.test/reset-password?token=demo" target="_blank" rel="noopener" style="display:inline-block;min-height:46px;line-height:46px;padding:0 28px;font-size:15px;font-weight:600;letter-spacing:0.01em;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Reset password&nbsp;&rarr;</a></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 8px;border-top:1px solid #2A2A2E;"><tr><td style="padding-top:20px;"><p class="mo-muted" style="margin:0 0 6px;color:#A1A1AA;font-size:12px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:</p><a class="mo-link" href="https://app.meetops.test/reset-password?token=demo" style="color:#3AB0E0;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.6;text-decoration:underline;word-break:break-all;">https://app.meetops.test/reset-password?token=demo</a></td></tr></table><p class="mo-muted" style="margin:0 0 16px;color:#A1A1AA;font-size:13px;line-height:1.65;">If it wasn&#39;t you, no action is needed. Nobody can sign in without your password.</p></td></tr></table></td></tr><tr><td style="padding:28px 4px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding-bottom:16px;border-bottom:1px solid #2A2A2E;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="22" style="width:22px;"><img src="cid:meetops-logo@meetops" width="22" height="22" alt="MeetOps AI" style="display:block;width:22px;height:22px;border:0;outline:none;text-decoration:none;border-radius:6px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:8px;color:#F5F5F7;font-size:14px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td style="padding-top:16px;"><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">MeetOps AI turns meetings into reviewed, synced tasks.</p><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">You&#39;re receiving this security email because of activity on your MeetOps account. It can&#39;t be turned off.</p><p class="mo-muted" style="margin:0;color:#A1A1AA;font-size:12px;">&copy; MeetOps AI</p></td></tr></table></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > account-exists > matches html and text snapshots > subject 1`] = `"You already have a MeetOps account"`;

exports[`email catalog > account-exists > matches html and text snapshots > text 1`] = `
"MeetOps

Hi there,

Someone tried to sign up with this email address, but it already has a MeetOps account. If that was you, sign in or reset your password.

Reset password: https://app.meetops.test/reset-password?token=demo

If it wasn't you, no action is needed. Nobody can sign in without your password.

--
You're receiving this security email because of activity on your MeetOps account. It can't be turned off.
"
`;

exports[`email catalog > integration-error > matches html and text snapshots > html 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>Action needed: Jira connection error</title><style>@media (prefers-color-scheme: light){.mo-bg{background-color:#FFFFFF!important}.mo-surface{background-color:#F5F5F7!important;border-color:#D4D4D8!important}.mo-text{color:#111113!important}.mo-muted{color:#52525B!important}.mo-link{color:#005F82!important}}[data-ogsc] .mo-text{color:#111113!important}@media only screen and (max-width:620px){.mo-container{width:100%!important}.mo-pad{padding:28px 22px!important}.mo-h1{font-size:24px!important}}</style></head><body class="mo-bg" style="margin:0;padding:0;background-color:#0A0A0A;-webkit-text-size-adjust:100%;"><div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0A0A0A;">MeetOps can&#39;t reach Jira. Reconnect to keep tasks syncing.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&n