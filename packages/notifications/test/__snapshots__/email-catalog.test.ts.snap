,Roboto,Helvetica,Arial,sans-serif;">Transcribe</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">AI summary</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Tasks</td><td width="20%" align="center" style="padding:0 0 22px;color:#A1A1AA;font-size:12px;line-height:16px;font-weight:500;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Sync</td></tr></table></td></tr></table><!--[if gte mso 9]></v:textbox></v:rect><![endif]--></div></td></tr><tr><td class="mo-pad" style="padding:40px 40px 32px;"><p class="mo-link" style="margin:0 0 12px;color:#3AB0E0;font-size:12px;line-height:16px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;"><span style="display:inline-block;width:8px;height:8px;margin:0 8px 1px 0;border-radius:50%;background-color:#FF2D95;vertical-align:middle;"></span>Meeting summary</p><h1 class="mo-text mo-h1" style="margin:0 0 16px;font-size:28px;line-height:1.2;letter-spacing:-0.02em;font-weight:700;color:#F5F5F7;">Weekly product sync</h1><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 16px;"><tr><td style="padding:0 8px 8px 0;"><span class="mo-text" style="display:inline-block;padding:5px 12px;border-radius:999px;background-color:#1C1C1F;border:1px solid #2A2A2E;color:#F5F5F7;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap;">26 Oct 2026</span></td><td style="padding:0 8px 8px 0;"><span class="mo-text" style="display:inline-block;padding:5px 12px;border-radius:999px;background-color:#1C1C1F;border:1px solid #2A2A2E;color:#F5F5F7;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap;">2 action items</span></td></tr></table><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Hi Ana,</p><p class="mo-text" style="margin:0 0 16px;color:#F5F5F7;font-size:15px;line-height:1.65;">Your meeting has been processed. Here is the summary.</p><h2 class="mo-muted" style="margin:8px 0 12px;font-size:13px;line-height:20px;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;color:#A1A1AA;">Summary</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px;border-collapse:separate;"><tr><td class="mo-surface" bgcolor="#1C1C1F" style="background-color:#1C1C1F;padding:18px 20px;border:1px solid #2A2A2E;border-left:3px solid #007BA7;border-radius:12px;"><p class="mo-text" style="margin:0 0 0px;color:#F5F5F7;font-size:15px;font-weight:400;line-height:1.6;">We agreed to ship the upload queue on Friday.<br>Desktop sign-in waits on ADR-012.</p></td></tr></table><h2 class="mo-muted" style="margin:8px 0 12px;font-size:13px;line-height:20px;letter-spacing:0.06em;text-transform:uppercase;font-weight:600;color:#A1A1AA;">Action items</h2><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="mo-surface" bgcolor="#1C1C1F" style="margin:0 0 24px;background-color:#1C1C1F;border:1px solid #2A2A2E;border-radius:12px;border-collapse:separate;"><tr><td width="28" valign="top" style="padding:14px 0 14px 16px;"><span class="mo-link" style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:6px;background-color:#0B2531;color:#3AB0E0;font-size:12px;font-weight:700;">1</span></td><td valign="top" style="padding:14px 16px 14px 12px;"><p class="mo-text" style="margin:0;color:#F5F5F7;font-size:15px;line-height:1.5;font-weight:500;">Ship upload queue</p><p class="mo-muted" style="margin:4px 0 0;color:#A1A1AA;font-size:13px;line-height:1.5;">Owner: Bo &nbsp;&middot;&nbsp; Due: 30 Oct</p></td></tr><tr><td width="28" valign="top" style="padding:14px 0 14px 16px;border-top:1px solid #2A2A2E;"><span class="mo-link" style="display:inline-block;width:22px;height:22px;line-height:22px;text-align:center;border-radius:6px;background-color:#0B2531;color:#3AB0E0;font-size:12px;font-weight:700;">2</span></td><td valign="top" style="padding:14px 16px 14px 12px;border-top:1px solid #2A2A2E;"><p class="mo-text" style="margin:0;color:#F5F5F7;font-size:15px;line-height:1.5;font-weight:500;">Review ADR-012</p></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 28px;"><tr><td align="center" bgcolor="#007BA7" style="border-radius:8px;background-color:#007BA7;border:1px solid #3AB0E0;"><a href="https://app.meetops.test/meetings/m1" target="_blank" rel="noopener" style="display:inline-block;min-height:46px;line-height:46px;padding:0 28px;font-size:15px;font-weight:600;letter-spacing:0.01em;color:#FFFFFF;text-decoration:none;border-radius:8px;mso-line-height-rule:exactly;">Open meeting&nbsp;&rarr;</a></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 8px;border-top:1px solid #2A2A2E;"><tr><td style="padding-top:20px;"><p class="mo-muted" style="margin:0 0 6px;color:#A1A1AA;font-size:12px;line-height:1.5;">If the button doesn&#39;t work, copy and paste this link into your browser:</p><a class="mo-link" href="https://app.meetops.test/meetings/m1" style="color:#3AB0E0;font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.6;text-decoration:underline;word-break:break-all;">https://app.meetops.test/meetings/m1</a></td></tr></table></td></tr></table></td></tr><tr><td style="padding:28px 4px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td style="padding-bottom:16px;border-bottom:1px solid #2A2A2E;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="22" style="width:22px;"><img src="cid:meetops-logo@meetops" width="22" height="22" alt="MeetOps AI" style="display:block;width:22px;height:22px;border:0;outline:none;text-decoration:none;border-radius:6px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:8px;color:#F5F5F7;font-size:14px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td style="padding-top:16px;"><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">MeetOps AI turns meetings into reviewed, synced tasks.</p><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;">You&#39;re receiving this because of your MeetOps notification settings.</p><p class="mo-muted" style="margin:0 0 8px;color:#A1A1AA;font-size:12px;line-height:1.6;"><a class="mo-link" href="https://app.meetops.test/settings/notifications" style="color:#3AB0E0;text-decoration:underline;">Manage email preferences</a> &nbsp;&middot;&nbsp; <a class="mo-link" href="https://app.meetops.test/u/one-click?t=demo" style="color:#3AB0E0;text-decoration:underline;">Unsubscribe</a></p><p class="mo-muted" style="margin:0;color:#A1A1AA;font-size:12px;">&copy; MeetOps AI</p></td></tr></table></td></tr></table></td></tr></table></body></html>"`;

exports[`email catalog > meeting-summary > matches html and text snapshots > subject 1`] = `"Summary ready: Weekly product sync"`;

exports[`email catalog > meeting-summary > matches html and text snapshots > text 1`] = `
"MeetOps

Hi Ana,

Weekly product sync (26 Oct 2026)

Summary:
We agreed to ship the upload queue on Friday.
Desktop sign-in waits on ADR-012.

Action items:
- Ship upload queue — Owner: Bo — Due: 30 Oct
- Review ADR-012

Open meeting: https://app.meetops.test/meetings/m1

--
You're receiving this because of your MeetOps notification settings.
Manage email preferences: https://app.meetops.test/settings/notifications
Unsubscribe: https://app.meetops.test/u/one-click?t=demo
"
`;

exports[`email catalog > member-added > matches html and text snapshots > html 1`] = `"<!doctype html><html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="color-scheme" content="dark light"><meta name="supported-color-schemes" content="dark light"><meta name="x-apple-disable-message-reformatting"><title>You&#39;ve been added to Acme Inc</title><style>@media (prefers-color-scheme: light){.mo-bg{background-color:#FFFFFF!important}.mo-surface{background-color:#F5F5F7!important;border-color:#D4D4D8!important}.mo-text{color:#111113!important}.mo-muted{color:#52525B!important}.mo-link{color:#005F82!important}}[data-ogsc] .mo-text{color:#111113!important}@media only screen and (max-width:620px){.mo-container{width:100%!important}.mo-pad{padding:28px 22px!important}.mo-h1{font-size:24px!important}}</style></head><body class="mo-bg" style="margin:0;padding:0;background-color:#0A0A0A;-webkit-text-size-adjust:100%;"><div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#0A0A0A;">You now have access to Acme Inc on MeetOps.&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="mo-bg" width="100%" bgcolor="#0A0A0A" style="background-color:#0A0A0A;"><tr><td align="center" style="padding:40px 12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" class="mo-container" width="600" style="width:600px;max-width:600px;font-family:InterVariable,Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;"><tr><td style="padding:0 4px 24px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td width="36" style="width:36px;"><img src="cid:meetops-logo@meetops" width="36" height="36" alt="MeetOps AI" style="display:block;width:36px;height:36px;border:0;outline:none;text-decoration:none;border-radius:9px;color:#F5F5F7;font-size:10px;"></td><td class="mo-text" style="padding-left:12px;color:#F5F5F7;font-size:19px;font-weight:600;letter-spacing:-0.01em;white-space:nowrap;">MeetOps <span class="mo-link" style="color:#3AB0E0;">AI</span></td></tr></table></td></tr><tr><td class="mo-surface" bgcolor="#141416" style="background-color:#141416;border:1px solid #2A2A2E;border-radius:16px;overflow:hidden;"><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td><div style="background-color:#0D0D10;border-bottom:1px solid #2A2A2E;border-radius:16px 16px 0 0;overflow:hidden;"><!--[if gte mso 9]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:600px;"><v:fill type="gradient" color="#0D0D10" color2="#0B2531" angle="135"/><v:textbox style="mso-fit-shape-to-text:true" inset="0,0,0,0"><![endif]--><table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" bgcolor="#0D0D10" style="background-color:#0D0D10;"><tr><td style="padding:28px 40px 8px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td valign="middle" style="width:8px;"><