{
  "name": "@meetops/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=../../.env ./node_modules/prisma/build/index.js db seed",
    "db:studio": "node --env-file=../../.env ./node_modules/prisma/build/index.js studio",
    "test:live": "vitest run test/rls.live.test.ts test/tenant-isolation.live.test.ts test/media.live.test.ts test/key-prefix.live.test.ts test/ai-transcripts.live.test.ts test/directory.live.test.ts",
    "db:roles": "tsx --env-file=../../.env scripts/create-db-roles.ts",
    "db:roles:sh": "sh scripts/create-db-roles.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "tsx --env-file=../../.env prisma/seed.ts"
  }
}
