// MeetOps AI core data model (PostgreSQL + pgvector)
// Conventions: uuid ids, camelCase fields mapped to snake_case columns,
// snake_case table names, org_id on every tenant-scoped table with indexes leading with org_id.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Runtime app role (meetops_app, NOBYPASSRLS). Migrations use the owner role via directUrl.
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATION_DATABASE_URL")
  extensions = [vector]
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// Role of an employee inside a team (contracts v0.4 TeamMember.role).
enum TeamMemberRole {
  lead
  member
}

enum ProjectStatus {
  active
  archived
}

enum MeetingStatus {
  scheduled
  recording
  processing
  completed
  failed
}

enum MeetingParticipantRole {
  host
  participant
}

enum TranscriptStatus {
  pending
  processing
  ready
  failed
}

enum ReportStatus {
  draft
  published
  archived
}

enum ExtractedTaskStatus {
  pending_review
  approved
  rejected
  converted
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AiRunKind {
  transcription
  summary
  task_extraction
  embedding
  other
}

enum StorageObjectKind {
  raw
  normalized
  chunk
}

enum OutboxStatus {
  pending
  processing
  published
  failed
}

enum MeetingSource {
  upload
  extension
  desktop
  bot
}

enum RecordingStatus {
  uploading
  uploaded
  processing
  ready
  failed
}

/// Contracts v0.2 RecordingSource.
enum RecordingSource {
  tab
  mobile
  desktop
}

/// Upload-session lifecycle. After `completed`, the contract's RecordingStatus lives on the linked recording.
enum RecordingSessionStatus {
  uploading
  completed
  aborted
  failed
}

/// Contracts v0.2 AbortReason.
enum RecordingAbortReason {
  user_stopped
  consent_revoked
  tab_closed
  local_storage_exhausted
  error
}

/// Granularity of an AiUsageCounter bucket.
enum AiUsagePeriodKind {
  day
  month
}

enum AiIdempotencyStatus {
  pending
  succeeded
  failed
}

enum TranscriptChunkStatus {
  pending
  processing
  done
  failed
}

enum TranscriptMergeStatus {
  pending
  merging
  merged
  failed
}

enum StorageObjectStatus {
  pending_upload
  uploaded
  processing
  ready
  failed
}

/// G11 (DB-3): content / malware scan state of a FileObject. Only `clean` objects may be processed or downloaded.
enum FileScanStatus {
  pending
  clean
  quarantined
  rejected
}

/// G11 (DB-3): what a consent attestation is attached to (contracts CONSENT_SUBJECT_TYPES).
enum ConsentSubjectType {
  upload
  recording_session
}

/// G11 (DB-3): how consent was obtained (contracts CONSENT_METHODS).
enum ConsentMethod {
  all_parties_notified
  all_parties_consented
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships            Membership[]
  invitations            Invitation[]
  employees              Employee[]
  projects               Project[]
  meetings               Meeting[]
  meetingParticipants    MeetingParticipant[]
  fileObjects            FileObject[]
  transcripts            Transcript[]
  transcriptSegments     TranscriptSegment[]
  reports                Report[]
  extractedTasks         ExtractedTask[]
  taskApprovals          TaskApproval[]
  tasks                  Task[]
  integrationIssues      IntegrationIssue[]
  aiRuns                 AiRun[]
  outboxEvents           OutboxEvent[]
  auditEvents            AuditEvent[]
  recordings             Recording[]
  recordingSessions      RecordingSession[]
  recordingSessionChunks RecordingSessionChunk[]
  activeSessions         Session[]
  aiUsageCounters        AiUsageCounter[]
  aiConfig               AiOrganizationConfig?
  aiIdempotencyKeys      AiIdempotency[]
  transcriptChunks       TranscriptChunk[]
  teams                  Team[]
  teamMembers            TeamMember[]
  consentAttestations    ConsentAttestation[]
  integrationConnections IntegrationConnection[]
  calendarConnections    CalendarConnection[]
  authDevices            AuthDevice[]
  authTokenFamilies      AuthTokenFamily[]
  authRefreshTokens      AuthRefreshToken[]
  notifications          Notification[]
  notificationDeliveryAttempts NotificationDeliveryAttempt[]
  notificationPreferences NotificationPreference[]
  pushDeviceTokens       PushDeviceToken[]

  createdBy User? @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("organizations")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships           Membership[]
  sessions              Session[]
  invitationsSent       Invitation[]         @relation("InvitationInviter")
  employees             Employee[]
  meetingsCreated       Meeting[]            @relation("MeetingCreator")
  fileObjectsUploaded   FileObject[]         @relation("FileUploader")
  taskApprovals         TaskApproval[]
  tasksCreated          Task[]               @relation("TaskCreator")
  meetingParticipations MeetingParticipant[] @relation("ParticipantUser")
  auditEvents           AuditEvent[]

  organizationsCreated Organization[]         @relation("OrgCreator")
  invitationsAccepted  Invitation[]           @relation("InvitationAcceptor")
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  recordingSessions    RecordingSession[]     @relation("RecordingSessionCreator")
  aiConfigsUpdated     AiOrganizationConfig[] @relation("AiOrganizationConfigUpdater")
  consentAttestations  ConsentAttestation[]   @relation("ConsentAttester")
  authDevices          AuthDevice[]           @relation("AuthDeviceOwner")
  authTokenFamilies    AuthTokenFamily[]      @relation("AuthTokenFamilyOwner")
  notifications        Notification[]         @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceOwner")
  pushDeviceTokens     PushDeviceToken[]      @relation("PushDeviceTokenOwner")
  calendarConnections  CalendarConnection[]   @relation("CalendarConnectionOwner")

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("org_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(member)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
  @@index([userId])
  @@map("memberships")
}

/// Global (user-scoped) table: sessions are resolved before an org context exists.
/// Only SHA-256(token) is stored; the raw opaque token is never persisted.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  activeOrgId       String?   @map("active_org_id") @db.Uuid
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  /// ADR-014 coarse GeoIP (null for private/unknown IPs). No lat/long.
  geoCity           String?   @map("geo_city") @db.VarChar(128)
  geoRegion         String?   @map("geo_region") @db.VarChar(128)
  geoCountry        String?   @map("geo_country") @db.VarChar(128)
  geoCountryCode    String?   @map("geo_country_code") @db.Char(2)
  geoApproximate    Boolean?  @map("geo_approximate")
  /// Idle expiry (sliding).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Hard cap regardless of activity.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  authLevel         String    @default("password") @map("auth_level")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrg Organization? @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrgId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("org_id") @db.Uuid
  email          String
  role           MembershipRole   @default(member)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("invitations")
}

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  email          String?
  title          String?
  department     String?
  externalId     String?   @map("external_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  extractedTasks ExtractedTask[]
  tasks          Task[]
  teamMembers    TeamMember[]

  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, fullName])
  @@map("employees")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("org_id") @db.Uuid
  teamId         String?       @map("team_id") @db.Uuid
  name           String
  key            String
  description    String?
  status         ProjectStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optional owning team. Composite FK keeps it in the same organization; Restrict (not SetNull) because
  /// SetNull on a composite FK would also null org_id. Teams are soft-deleted, so this rarely fires.
  team         Team?        @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  meetings     Meeting[]
  tasks        Task[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, teamId])
  @@map("projects")
}

/// A team inside an organization (contracts v0.4 Team). Tenant table: forced RLS on org_id (ADR-010).
model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  name           String
  key            String?
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("teams")
}

/// Employee membership in a team. Both parents are reached through composite (org_id, id) FKs, so a member
/// row can never point at another organization's team or employee. Unique per (team, employee):
/// a duplicate maps to TEAM_MEMBER_EXISTS.
model TeamMember {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("org_id") @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  role           TeamMemberRole @default(member)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, teamId, employeeId])
  @@index([organizationId, employeeId])
  @@map("team_members")
}

model Meeting {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("org_id") @db.Uuid
  projectId         String?       @map("project_id") @db.Uuid
  createdById       String?       @map("created_by_id") @db.Uuid
  title             String
  description       String?
  source            MeetingSource @default(upload)
  /// External call id for extension/desktop/bot meetings (meetings/resolve idempotency key). Null for uploads.
  externalMeetingId String?       @map("external_meeting_id")
  status            MeetingStatus @default(scheduled)
  scheduledAt       DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  startedAt         DateTime?     @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSec       Int?          @map("duration_sec")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project?             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User?                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants      MeetingParticipant[]
  transcripts       Transcript[]
  reports           Report[]
  extractedTasks    ExtractedTask[]
  aiRuns            AiRun[]
  recordings        Recording[]
  recordingSessions RecordingSession[]
  fileObjects       FileObject[]
  tasks             Task[]

  @@unique([organizationId, id])
  @@unique([organizationId, source, externalMeetingId])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, createdAt, id])
  @@map("meetings")
}

model MeetingParticipant {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("org_id") @db.Uuid
  meetingId      String                 @map("meeting_id") @db.Uuid
  displayName    String                 @map("display_name")
  email          String?
  speakerLabel   String?                @map("speaker_label")
  role           MeetingParticipantRole @default(participant)
  /// Platform user, null for external attendees (contracts v0.2).
  userId         String?                @map("user_id") @db.Uuid
  joinedAt       DateTime?              @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?              @map("left_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting             @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  user         User?               @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  segments     TranscriptSegment[]

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@index([organizationId, meetingId])
  @@map("meeting_participants")
}

/// Single storage-object table for every blob in object storage (uploads, raw/normalized media, chunks).
/// Media lineage via parent_object_id; a Recording points at its raw object.
model FileObject {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("org_id") @db.Uuid
  meetingId       String?             @map("meeting_id") @db.Uuid
  parentObjectId  String?             @map("parent_object_id") @db.Uuid
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  kind            StorageObjectKind   @default(raw)
  status          StorageObjectStatus @default(pending_upload)
  provider        String              @default("s3")
  bucket          String
  /// Always prefixed organizations/{organizationId}/ (ADR-010, 2026-10-24). Legacy org/{organizationId}/ keys are
  /// readable during phase A only and are copied over by scripts/backfill-organization-keys.ts.
  key             String              @unique @map("storage_key")
  mimeType        String              @map("mime_type")
  sizeBytes       BigInt?             @map("size_bytes")
  etag            String?
  /// Lowercase hex SHA-256 (64 chars), CHECK in SQL (NOT VALID for pre-existing rows).
  checksumSha256  String?             @map("checksum_sha256")
  originalName    String?             @map("original_name")
  durationSeconds Float?              @map("duration_seconds")
  format          String?
  sampleRate      Int?                @map("sample_rate")
  channels        Int?
  chunkIndex      Int?                @map("chunk_index")
  startSeconds    Float?              @map("start_seconds")
  uploadId        String?             @map("upload_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)
  /// G11 (DB-3): every new object starts `pending` until the scanner records a verdict.
  scanStatus      FileScanStatus      @default(pending) @map("scan_status")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting?     @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Restrict)
  parent       FileObject?  @relation("StorageLineage", fields: [organizationId, parentObjectId], references: [organizationId, id], onDelete: Restrict)
  children     FileObject[] @relation("StorageLineage")
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  recording    Recording?

  @@unique([organizationId, id])
  @@unique([organizationId, bucket, key])
  @@unique([parentObjectId, chunkIndex])
  @@index([organizationId, meetingId, kind])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, scanStatus])
  @@map("file_objects")
}

/// G11 (DB-3): server-side consent evidence for an upload (FileObject id) or a recording session. Append-only
/// (UPDATE/DELETE/TRUNCATE raise, like audit_events) under forced RLS. organizationId and attestedByUserId come
/// from the authenticated session, never from the request. subjectId is checked by a trigger to be a row of the
/// same organization at insert time (no FK: the subject is polymorphic and the evidence outlives it).
model ConsentAttestation {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("org_id") @db.Uuid
  subjectType      ConsentSubjectType @map("subject_type")
  subjectId        String             @map("subject_id") @db.Uuid
  /// contracts CONSENT_VERSION_PATTERN, CHECK in SQL.
  consentVersion   String             @map("consent_version")
  method           ConsentMethod
  attestedByUserId String             @map("attested_by_user_id") @db.Uuid
  /// Client clock; CHECK: at most 300 s after recordedAt (contracts CONSENT_ATTESTATION_MAX_SKEW_SECONDS).
  attestedAt       DateTime           @map("attested_at") @db.Timestamptz(3)
  /// Server receive time.
  recordedAt       DateTime           @default(now()) @map("recorded_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attestedBy   User         @relation("ConsentAttester", fields: [attestedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, subjectType, subjectId])
  @@index([organizationId, attestedByUserId])
  @@map("consent_attestations")
}

model Recording {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("org_id") @db.Uuid
  meetingId      String          @map("meeting_id") @db.Uuid
  fileObjectId   String          @unique @map("file_object_id") @db.Uuid
  durationMs     Int?            @map("duration_ms")
  /// Number of STT chunks produced by the media worker (null until processed). CHECK 1..10000 in SQL.
  /// Not recording_sessions.chunk_count, which counts uploaded session parts.
  chunkCount     Int?            @map("chunk_count")
  status         RecordingStatus @default(uploading)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting           @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  file         FileObject        @relation(fields: [organizationId, fileObjectId], references: [organizationId, id], onDelete: Restrict)
  transcripts  Transcript[]
  session      RecordingSession?

  @@unique([organizationId, id])
  @@unique([organizationId, fileObjectId])
  @@index([organizationId, meetingId])
  @@map("recordings")
}

model Transcript {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("org_id") @db.Uuid
  meetingId      String                @map("meeting_id") @db.Uuid
  recordingId    String                @map("recording_id") @db.Uuid
  /// Transcription provider (e.g. "deepgram") and its job id, for idempotent webhook/poll handling.
  provider       String
  providerJobId  String?               @map("provider_job_id")
  revision       Int                   @default(1)
  status         TranscriptStatus      @default(pending)
  language       String?
  fullText       String?               @map("full_text")
  /// Chunked transcription: merge of TranscriptChunk rows into fullText/segments (single winner via tryBeginMerge).
  mergeStatus    TranscriptMergeStatus @default(pending) @map("merge_status")
  mergedAt       DateTime?             @map("merged_at") @db.Timestamptz(3)
  /// ai-core merge state for this revision (content hash, chunk indexes, speaker map). Null on the revision-0 anchor.
  mergeState     Json?                 @map("merge_state")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting             @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  recording    Recording           @relation(fields: [organizationId, recordingId], references: [organizationId, id], onDelete: Restrict)
  segments     TranscriptSegment[]
  reports      Report[]
  aiRuns       AiRun[]
  chunks       TranscriptChunk[]

  /// Revision 0 is the per-recording anchor that owns TranscriptChunk rows; >= 1 are merged revisions.
  @@unique([recordingId, revision])
  @@unique([organizationId, provider, providerJobId])
  @@unique([organizationId, id])
  @@index([organizationId, meetingId])
  @@map("transcripts")
}

