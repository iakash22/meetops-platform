enum IntegrationConnectionStatus {
  active
  error
  revoked
}

/// Phase 5 (ADR-008): one connected provider account per organization. Secrets are stored only as TokenCipher
/// envelopes (`v1.<keyId>.<wrappedKey>.<iv|ct|tag>`, AAD = org + integration id) produced by
/// @meetops/integrations; this package never sees a KEK. `tokenKeyId` mirrors the envelope key id so key
/// rotation can find rows to re-wrap. The webhook secret is per connection and bound to org_id by RLS.
model IntegrationConnection {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @map("org_id") @db.Uuid
  provider             String
  status               IntegrationConnectionStatus @default(active)
  displayName          String                      @map("display_name")
  externalAccountId    String                      @map("external_account_id")
  connectedById        String?                     @map("connected_by_id") @db.Uuid
  /// NULL only once revoked (disconnect wipes every secret; enforced by a CHECK).
  accessTokenEnc       String?                     @map("access_token_enc")
  refreshTokenEnc      String?                     @map("refresh_token_enc")
  webhookSecretEnc     String?                     @map("webhook_secret_enc")
  tokenKeyId           String                      @map("token_key_id")
  accessTokenExpiresAt DateTime?                   @map("access_token_expires_at") @db.Timestamptz(3)
  /// Set by soft disconnect (status revoked). The app role has no DELETE on this table.
  revokedAt            DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, provider, externalAccountId])
  @@index([tokenKeyId])
  @@map("integration_connections")
}

/// ADR-005 A1.2 / ADR-012: who a bearer token family was issued to. `extension` today; `desktop` once ADR-012 is accepted.
enum AuthTokenAudience {
  extension
  desktop
}

/// A paired client install (ADR-005 A1.1: per-install deviceId) for one user in one organization. clientId is the
/// allowlisted extension id (or the desktop app id). Tenant table: forced RLS, ADR-010 setting only.
model AuthDevice {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("org_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  audience       AuthTokenAudience
  clientId       String            @map("client_id")
  /// Client-generated per-install id (UUID per ADR-005 A1.1.2).
  deviceId       String            @map("device_id") @db.Uuid
  label          String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation("AuthDeviceOwner", fields: [userId], references: [id], onDelete: Cascade)
  families     AuthTokenFamily[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId, audience, clientId, deviceId])
  @@index([organizationId, userId])
  @@map("auth_devices")
}

/// A rotating refresh family (ADR-005 A1.2.3-4). Rotation never extends maxExpiresAt. Revocation is durable here;
/// access tokens (15 min) stay in Redis only.
model AuthTokenFamily {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("org_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  authDeviceId   String            @map("auth_device_id") @db.Uuid
  audience       AuthTokenAudience
  scopes         String[]
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  maxExpiresAt   DateTime          @map("max_expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User               @relation("AuthTokenFamilyOwner", fields: [userId], references: [id], onDelete: Cascade)
  device        AuthDevice         @relation(fields: [organizationId, authDeviceId], references: [organizationId, id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@index([organizationId, authDeviceId])
  @@map("auth_token_families")
}

/// One issued refresh token, stored only as a SHA-256 hash (CHECK: 64 lowercase hex). consumedAt set = rotated;
/// presenting it again is reuse and revokes the family (ADR-005 A1.2.3).
model AuthRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family       AuthTokenFamily @relation(fields: [organizationId, familyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, familyId])
  @@map("auth_refresh_tokens")
}

/// ADR-013 delivery channels. `in_app` is the Postgres feed (source of truth); the others only point back to it.
enum NotificationChannel {
  in_app
  email
  web_push
  mobile_push
  desktop
}

/// Outcome of one delivery attempt. `skipped` = suppressed by preferences / no device; `failed` may be retried.
enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

/// Push token family: Web Push (VAPID; web + MV3 extension) or Expo Push (mobile).
enum PushPlatform {
  web
  extension
  ios
  android
}

/// ADR-013 in-app feed item for one recipient. Payload is ids-only (`data`), rendered by clients. Idempotent on
/// (org, user, dedupe_key) so a replayed outbox event never creates a second row.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  subjectType    String?   @map("subject_type")
  subjectId      String?   @map("subject_id") @db.Uuid
  data           Json      @default("{}")
  dedupeKey      String    @map("dedupe_key")
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                          @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  attempts     NotificationDeliveryAttempt[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId, dedupeKey])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

/// One row per channel delivery attempt. `deliveryKey` is the BullMQ jobId; (org, deliveryKey, attempt) is unique so
/// a retried job records each attempt once. Never stores message bodies or push tokens.
model NotificationDeliveryAttempt {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @map("org_id") @db.Uuid
  notificationId    String                     @map("notification_id") @db.Uuid
  channel           NotificationChannel
  deliveryKey       String                     @map("delivery_key")
  attempt           Int                        @default(1)
  status            NotificationDeliveryStatus @default(pending)
  pushDeviceTokenId String?                    @map("push_device_token_id") @db.Uuid
  providerMessageId String?                    @map("provider_message_id")
  errorCode         String?                    @map("error_code")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?                  @map("completed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [organizationId, notificationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, deliveryKey, attempt])
  @@index([organizationId, notificationId])
  @@map("notification_delivery_attempts")
}

/// Per-user, per-type, per-channel opt in/out. `type` = '*' is the channel-wide default. Absent row = product default.
model NotificationPreference {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("org_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  type           String
  channel        NotificationChannel
  enabled        Boolean
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationPreferenceOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, userId, type, channel])
  @@map("notification_preferences")
}

/// Push device token (ADR-013 `PushDevice`), org-scoped so it sits under forced tenant RLS. The token is stored only
/// encrypted (ADR-008 envelope, AAD = org + row id) plus a SHA-256 hash for idempotent registration and lookup.
model PushDeviceToken {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  platform       PushPlatform
  tokenHash      String       @map("token_hash")
  tokenEnc       String?      @map("token_enc")
  tokenKeyId     String?      @map("token_key_id")
  label          String?
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("PushDeviceTokenOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, tokenHash])
  @@index([organizationId, userId])
  @@map("push_device_tokens")
}

enum CalendarConnectionStatus {
  active
  error
  revoked
}

/// Phase 7: one user's connected calendar account in one organization. Tokens are TokenCipher envelopes only
/// (AAD = org + connection id); disconnect wipes them (CHECK). Tenant table: forced RLS, ADR-010 setting only.
model CalendarConnection {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("org_id") @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  provider             String
  status               CalendarConnectionStatus @default(active)
  displayName          String                   @map("display_name")
  externalAccountId    String                   @map("external_account_id")
  accessTokenEnc       String?                  @map("access_token_enc")
  refreshTokenEnc      String?                  @map("refresh_token_enc")
  tokenKeyId           String                   @map("token_key_id")
  accessTokenExpiresAt DateTime?                @map("access_token_expires_at") @db.Timestamptz(3)
  revokedAt            DateTime?                @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("CalendarConnectionOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, userId, provider, externalAccountId])
  @@index([organizationId, userId])
  @@index([tokenKeyId])
  @@map("calendar_connections")
}
