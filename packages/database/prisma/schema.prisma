// MeetOps AI core data model (PostgreSQL + pgvector)
// Conventions: uuid ids, camelCase fields mapped to snake_case columns,
// snake_case table names, org_id on every tenant-scoped table with indexes leading with org_id.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Runtime app role (meetops_app, NOBYPASSRLS). Migrations use the owner role via directUrl.
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATION_DATABASE_URL")
  extensions = [vector]
}

enum MembershipRole {
  owner
  admin
  member
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

/// Role of an employee inside a team (contracts v0.4 TeamMember.role).
enum TeamMemberRole {
  lead
  member
}

enum ProjectStatus {
  active
  archived
}

enum MeetingStatus {
  scheduled
  recording
  processing
  completed
  failed
}

enum MeetingParticipantRole {
  host
  participant
}

enum TranscriptStatus {
  pending
  processing
  ready
  failed
}

enum ReportStatus {
  draft
  published
  archived
}

enum ExtractedTaskStatus {
  pending_review
  approved
  rejected
  converted
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum ApprovalDecision {
  approved
  rejected
  changes_requested
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum AiRunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AiRunKind {
  transcription
  summary
  task_extraction
  embedding
  other
}

enum StorageObjectKind {
  raw
  normalized
  chunk
}

enum OutboxStatus {
  pending
  processing
  published
  failed
}

enum MeetingSource {
  upload
  extension
  desktop
  bot
}

enum RecordingStatus {
  uploading
  uploaded
  processing
  ready
  failed
}

/// Contracts v0.2 RecordingSource.
enum RecordingSource {
  tab
}

/// Upload-session lifecycle. After `completed`, the contract's RecordingStatus lives on the linked recording.
enum RecordingSessionStatus {
  uploading
  completed
  aborted
  failed
}

/// Contracts v0.2 AbortReason.
enum RecordingAbortReason {
  user_stopped
  consent_revoked
  tab_closed
  local_storage_exhausted
  error
}

/// Granularity of an AiUsageCounter bucket.
enum AiUsagePeriodKind {
  day
  month
}

enum AiIdempotencyStatus {
  pending
  succeeded
  failed
}

enum TranscriptChunkStatus {
  pending
  processing
  done
  failed
}

enum TranscriptMergeStatus {
  pending
  merging
  merged
  failed
}

enum StorageObjectStatus {
  pending_upload
  uploaded
  processing
  ready
  failed
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships            Membership[]
  invitations            Invitation[]
  employees              Employee[]
  projects               Project[]
  meetings               Meeting[]
  meetingParticipants    MeetingParticipant[]
  fileObjects            FileObject[]
  transcripts            Transcript[]
  transcriptSegments     TranscriptSegment[]
  reports                Report[]
  extractedTasks         ExtractedTask[]
  taskApprovals          TaskApproval[]
  tasks                  Task[]
  integrationIssues      IntegrationIssue[]
  aiRuns                 AiRun[]
  outboxEvents           OutboxEvent[]
  auditEvents            AuditEvent[]
  recordings             Recording[]
  recordingSessions      RecordingSession[]
  recordingSessionChunks RecordingSessionChunk[]
  activeSessions         Session[]
  aiUsageCounters        AiUsageCounter[]
  aiConfig               AiOrganizationConfig?
  aiIdempotencyKeys      AiIdempotency[]
  transcriptChunks       TranscriptChunk[]
  teams                  Team[]
  teamMembers            TeamMember[]

  createdBy User? @relation("OrgCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("organizations")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  passwordHash  String?   @map("password_hash")
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships           Membership[]
  sessions              Session[]
  invitationsSent       Invitation[]         @relation("InvitationInviter")
  employees             Employee[]
  meetingsCreated       Meeting[]            @relation("MeetingCreator")
  fileObjectsUploaded   FileObject[]         @relation("FileUploader")
  taskApprovals         TaskApproval[]
  tasksCreated          Task[]               @relation("TaskCreator")
  meetingParticipations MeetingParticipant[] @relation("ParticipantUser")
  auditEvents           AuditEvent[]

  organizationsCreated Organization[]         @relation("OrgCreator")
  invitationsAccepted  Invitation[]           @relation("InvitationAcceptor")
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  recordingSessions    RecordingSession[]     @relation("RecordingSessionCreator")
  aiConfigsUpdated     AiOrganizationConfig[] @relation("AiOrganizationConfigUpdater")

  @@map("users")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("org_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(member)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
  @@index([userId])
  @@map("memberships")
}

/// Global (user-scoped) table: sessions are resolved before an org context exists.
/// Only SHA-256(token) is stored; the raw opaque token is never persisted.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  activeOrgId       String?   @map("active_org_id") @db.Uuid
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")
  /// Idle expiry (sliding).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Hard cap regardless of activity.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  authLevel         String    @default("password") @map("auth_level")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrg Organization? @relation(fields: [activeOrgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOrgId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("org_id") @db.Uuid
  email          String
  role           MembershipRole   @default(member)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@index([organizationId, status])
  @@map("invitations")
}

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  fullName       String    @map("full_name")
  email          String?
  title          String?
  department     String?
  externalId     String?   @map("external_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  extractedTasks ExtractedTask[]
  tasks          Task[]
  teamMembers    TeamMember[]

  @@unique([organizationId, email])
  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, fullName])
  @@map("employees")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("org_id") @db.Uuid
  teamId         String?       @map("team_id") @db.Uuid
  name           String
  key            String
  description    String?
  status         ProjectStatus @default(active)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Optional owning team. Composite FK keeps it in the same organization; Restrict (not SetNull) because
  /// SetNull on a composite FK would also null org_id. Teams are soft-deleted, so this rarely fires.
  team         Team?        @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  meetings     Meeting[]
  tasks        Task[]

  @@unique([organizationId, key])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, teamId])
  @@map("projects")
}

/// A team inside an organization (contracts v0.4 Team). Tenant table: forced RLS on org_id (ADR-010).
model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  name           String
  key            String?
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  projects     Project[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("teams")
}

/// Employee membership in a team. Both parents are reached through composite (org_id, id) FKs, so a member
/// row can never point at another organization's team or employee. Unique per (team, employee):
/// a duplicate maps to TEAM_MEMBER_EXISTS.
model TeamMember {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("org_id") @db.Uuid
  teamId         String         @map("team_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  role           TeamMemberRole @default(member)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade)
  employee     Employee     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, teamId, employeeId])
  @@index([organizationId, employeeId])
  @@map("team_members")
}

model Meeting {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("org_id") @db.Uuid
  projectId      String?       @map("project_id") @db.Uuid
  createdById    String?       @map("created_by_id") @db.Uuid
  title          String
  description    String?
  source         MeetingSource @default(upload)
  status         MeetingStatus @default(scheduled)
  scheduledAt    DateTime?     @map("scheduled_at") @db.Timestamptz(3)
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSec    Int?          @map("duration_sec")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project?             @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User?                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants      MeetingParticipant[]
  transcripts       Transcript[]
  reports           Report[]
  extractedTasks    ExtractedTask[]
  aiRuns            AiRun[]
  recordings        Recording[]
  recordingSessions RecordingSession[]
  fileObjects       FileObject[]
  tasks             Task[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([organizationId, scheduledAt])
  @@map("meetings")
}

model MeetingParticipant {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("org_id") @db.Uuid
  meetingId      String                 @map("meeting_id") @db.Uuid
  displayName    String                 @map("display_name")
  email          String?
  speakerLabel   String?                @map("speaker_label")
  role           MeetingParticipantRole @default(participant)
  /// Platform user, null for external attendees (contracts v0.2).
  userId         String?                @map("user_id") @db.Uuid
  joinedAt       DateTime?              @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?              @map("left_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting             @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  user         User?               @relation("ParticipantUser", fields: [userId], references: [id], onDelete: SetNull)
  segments     TranscriptSegment[]

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@index([organizationId, meetingId])
  @@map("meeting_participants")
}

/// Single storage-object table for every blob in object storage (uploads, raw/normalized media, chunks).
/// Media lineage via parent_object_id; a Recording points at its raw object.
model FileObject {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("org_id") @db.Uuid
  meetingId       String?             @map("meeting_id") @db.Uuid
  parentObjectId  String?             @map("parent_object_id") @db.Uuid
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  kind            StorageObjectKind   @default(raw)
  status          StorageObjectStatus @default(pending_upload)
  provider        String              @default("s3")
  bucket          String
  /// Always prefixed organizations/{organizationId}/ (ADR-010, 2026-10-24). Legacy org/{organizationId}/ keys are
  /// readable during phase A only and are copied over by scripts/backfill-organization-keys.ts.
  key             String              @unique @map("storage_key")
  mimeType        String              @map("mime_type")
  sizeBytes       BigInt?             @map("size_bytes")
  etag            String?
  /// Lowercase hex SHA-256 (64 chars), CHECK in SQL (NOT VALID for pre-existing rows).
  checksumSha256  String?             @map("checksum_sha256")
  originalName    String?             @map("original_name")
  durationSeconds Float?              @map("duration_seconds")
  format          String?
  sampleRate      Int?                @map("sample_rate")
  channels        Int?
  chunkIndex      Int?                @map("chunk_index")
  startSeconds    Float?              @map("start_seconds")
  uploadId        String?             @map("upload_id")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting?     @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Restrict)
  parent       FileObject?  @relation("StorageLineage", fields: [organizationId, parentObjectId], references: [organizationId, id], onDelete: Restrict)
  children     FileObject[] @relation("StorageLineage")
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  recording    Recording?

  @@unique([organizationId, id])
  @@unique([organizationId, bucket, key])
  @@unique([parentObjectId, chunkIndex])
  @@index([organizationId, meetingId, kind])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("file_objects")
}

model Recording {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("org_id") @db.Uuid
  meetingId      String          @map("meeting_id") @db.Uuid
  fileObjectId   String          @unique @map("file_object_id") @db.Uuid
  durationMs     Int?            @map("duration_ms")
  /// Number of STT chunks produced by the media worker (null until processed). CHECK 1..10000 in SQL.
  /// Not recording_sessions.chunk_count, which counts uploaded session parts.
  chunkCount     Int?            @map("chunk_count")
  status         RecordingStatus @default(uploading)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting           @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  file         FileObject        @relation(fields: [organizationId, fileObjectId], references: [organizationId, id], onDelete: Restrict)
  transcripts  Transcript[]
  session      RecordingSession?

  @@unique([organizationId, id])
  @@unique([organizationId, fileObjectId])
  @@index([organizationId, meetingId])
  @@map("recordings")
}

model Transcript {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("org_id") @db.Uuid
  meetingId      String                @map("meeting_id") @db.Uuid
  recordingId    String                @map("recording_id") @db.Uuid
  /// Transcription provider (e.g. "deepgram") and its job id, for idempotent webhook/poll handling.
  provider       String
  providerJobId  String?               @map("provider_job_id")
  revision       Int                   @default(1)
  status         TranscriptStatus      @default(pending)
  language       String?
  fullText       String?               @map("full_text")
  /// Chunked transcription: merge of TranscriptChunk rows into fullText/segments (single winner via tryBeginMerge).
  mergeStatus    TranscriptMergeStatus @default(pending) @map("merge_status")
  mergedAt       DateTime?             @map("merged_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting             @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  recording    Recording           @relation(fields: [organizationId, recordingId], references: [organizationId, id], onDelete: Restrict)
  segments     TranscriptSegment[]
  reports      Report[]
  aiRuns       AiRun[]
  chunks       TranscriptChunk[]

  @@unique([meetingId, revision])
  @@unique([organizationId, provider, providerJobId])
  @@unique([organizationId, id])
  @@index([organizationId, meetingId])
  @@map("transcripts")
}

model TranscriptSegment {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("org_id") @db.Uuid
  transcriptId   String                       @map("transcript_id") @db.Uuid
  participantId  String?                      @map("participant_id") @db.Uuid
  revision       Int                          @default(1)
  sequence       Int
  speakerLabel   String?                      @map("speaker_label")
  startMs        Int                          @map("start_ms")
  endMs          Int                          @map("end_ms")
  text           String
  confidence     Float?
  embedding      Unsupported("vector(1536)")?
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transcript   Transcript          @relation(fields: [organizationId, transcriptId], references: [organizationId, id], onDelete: Cascade)
  participant  MeetingParticipant? @relation(fields: [organizationId, participantId], references: [organizationId, id], onDelete: Restrict)

  @@unique([transcriptId, revision, sequence])
  @@unique([organizationId, id])
  @@index([organizationId, transcriptId])
  @@map("transcript_segments")
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  meetingId      String       @map("meeting_id") @db.Uuid
  transcriptId   String?      @map("transcript_id") @db.Uuid
  aiRunId        String?      @map("ai_run_id") @db.Uuid
  version        Int          @default(1)
  status         ReportStatus @default(draft)
  title          String?
  summary        String?
  content        Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting         @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  transcript     Transcript?     @relation(fields: [organizationId, transcriptId], references: [organizationId, id], onDelete: Restrict)
  aiRun          AiRun?          @relation(fields: [organizationId, aiRunId], references: [organizationId, id], onDelete: Restrict)
  extractedTasks ExtractedTask[]

  @@unique([meetingId, version])
  @@unique([organizationId, id])
  @@index([organizationId, meetingId])
  @@map("reports")
}

model ExtractedTask {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("org_id") @db.Uuid
  meetingId           String              @map("meeting_id") @db.Uuid
  reportId            String              @map("report_id") @db.Uuid
  aiRunId             String?             @map("ai_run_id") @db.Uuid
  suggestedAssigneeId String?             @map("suggested_assignee_id") @db.Uuid
  title               String
  description         String?
  priority            TaskPriority        @default(medium)
  dueDate             DateTime?           @map("due_date") @db.Timestamptz(3)
  /// UNTRUSTED LLM hints (display only), contracts v0.2.
  assigneeHint        String?             @map("assignee_hint")
  dueHint             String?             @map("due_hint")
  confidence          Float?
  sourceSegmentIds    String[]            @map("source_segment_ids") @db.Uuid
  status              ExtractedTaskStatus @default(pending_review)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(3)

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting           Meeting        @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  report            Report         @relation(fields: [organizationId, reportId], references: [organizationId, id], onDelete: Restrict)
  aiRun             AiRun?         @relation(fields: [organizationId, aiRunId], references: [organizationId, id], onDelete: Restrict)
  suggestedAssignee Employee?      @relation(fields: [organizationId, suggestedAssigneeId], references: [organizationId, id], onDelete: Restrict)
  approvals         TaskApproval[]
  task              Task?

  @@unique([organizationId, id])
  @@index([organizationId, meetingId])
  @@index([organizationId, status])
  @@map("extracted_tasks")
}

model TaskApproval {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("org_id") @db.Uuid
  extractedTaskId String           @map("extracted_task_id") @db.Uuid
  reviewerId      String?          @map("reviewer_id") @db.Uuid
  decision        ApprovalDecision
  comment         String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  extractedTask ExtractedTask @relation(fields: [organizationId, extractedTaskId], references: [organizationId, id], onDelete: Cascade)
  reviewer      User?         @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, extractedTaskId])
  @@map("task_approvals")
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("org_id") @db.Uuid
  projectId       String?      @map("project_id") @db.Uuid
  extractedTaskId String?      @unique @map("extracted_task_id") @db.Uuid
  assigneeId      String?      @map("assignee_id") @db.Uuid
  createdById     String?      @map("created_by_id") @db.Uuid
  title           String
  description     String?
  status          TaskStatus   @default(todo)
  priority        TaskPriority @default(medium)
  meetingId       String?      @map("meeting_id") @db.Uuid
  dueAt           DateTime?    @map("due_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project?           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  meeting           Meeting?           @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Restrict)
  extractedTask     ExtractedTask?     @relation(fields: [organizationId, extractedTaskId], references: [organizationId, id], onDelete: Restrict)
  assignee          Employee?          @relation(fields: [organizationId, assigneeId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User?              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  integrationIssues IntegrationIssue[]

  @@unique([organizationId, id])
  @@unique([organizationId, extractedTaskId])
  @@index([organizationId, status])
  @@index([organizationId, projectId])
  @@index([organizationId, assigneeId])
  @@map("tasks")
}

model IntegrationIssue {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  /// Integration identifier, e.g. "jira", "linear", "github".
  integration    String
  /// Contracts v0.2: optional link to a configured integration instance (no integrations table yet).
  integrationId  String?   @map("integration_id") @db.Uuid
  /// Contracts v0.2: provider key, e.g. "linear", "jira", "github".
  provider       String
  externalId     String    @map("external_id")
  externalUrl    String?   @map("external_url")
  syncedAt       DateTime? @map("synced_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, provider, externalId])
  @@unique([organizationId, id])
  @@index([organizationId, taskId])
  @@map("integration_issues")
}

model AiRun {
  id                 String      @id @default(uuid()) @db.Uuid
  organizationId     String      @map("org_id") @db.Uuid
  meetingId          String?     @map("meeting_id") @db.Uuid
  transcriptId       String?     @map("transcript_id") @db.Uuid
  kind               AiRunKind
  provider           String
  model              String
  promptVersion      String      @map("prompt_version")
  transcriptRevision Int?        @map("transcript_revision")
  status             AiRunStatus @default(queued)
  inputTokens        Int?        @map("input_tokens")
  outputTokens       Int?        @map("output_tokens")
  totalTokens        Int?        @map("total_tokens")
  costUsd            Decimal?    @map("cost_usd") @db.Decimal(12, 6)
  /// Billed audio duration for transcription runs.
  audioSeconds       Decimal?    @map("audio_seconds") @db.Decimal(10, 3)
  latencyMs          Int?        @map("latency_ms")
  error              String?
  metadata           Json?
  startedAt          DateTime?   @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting        Meeting?        @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Restrict)
  transcript     Transcript?     @relation(fields: [organizationId, transcriptId], references: [organizationId, id], onDelete: Restrict)
  reports        Report[]
  extractedTasks ExtractedTask[]

  @@unique([organizationId, id])
  @@index([organizationId, meetingId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("ai_runs")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("org_id") @db.Uuid
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type")
  payload        Json
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([status, availableAt])
  @@map("outbox_events")
}

/// Append-only security/audit trail. UPDATE/DELETE are revoked from meetops_app in migrations.
/// org_id is NULL for global auth events (signup, failed login): insert-only for the app, never readable via RLS.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("org_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorType      String   @default("user") @map("actor_type")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, targetType, targetId])
  @@index([organizationId, actorId])
  @@map("audit_events")
}

/// Global (user-scoped, no org): looked up by token hash before login. Only SHA-256(token) stored.
model EmailVerification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// Global (user-scoped, no org): looked up by token hash before login. Only SHA-256(token) stored.
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

/// Chunked browser upload (contracts v0.2 recording-sessions API). Exists before any file object;
/// on complete it is linked to the Recording it produced.
model RecordingSession {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("org_id") @db.Uuid
  meetingId      String                 @map("meeting_id") @db.Uuid
  createdById    String?                @map("created_by_id") @db.Uuid
  recordingId    String?                @unique @map("recording_id") @db.Uuid
  mimeType       String                 @map("mime_type")
  source         RecordingSource        @default(tab)
  status         RecordingSessionStatus @default(uploading)
  abortReason    RecordingAbortReason?  @map("abort_reason")
  startedAt      DateTime               @map("started_at") @db.Timestamptz(3)
  chunkCount     Int?                   @map("chunk_count")
  durationMs     Int?                   @map("duration_ms")
  /// Running total of signed chunk sizes; capped at MAX_RECORDING_SESSION_BYTES.
  totalBytes     BigInt                 @default(0) @map("total_bytes")
  failureCode    String?                @map("failure_code")
  completedAt    DateTime?              @map("completed_at") @db.Timestamptz(3)
  abortedAt      DateTime?              @map("aborted_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting                 @relation(fields: [organizationId, meetingId], references: [organizationId, id], onDelete: Cascade)
  createdBy    User?                   @relation("RecordingSessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recording    Recording?              @relation(fields: [organizationId, recordingId], references: [organizationId, id], onDelete: Restrict)
  chunks       RecordingSessionChunk[]

  @@unique([organizationId, id])
  @@unique([organizationId, recordingId])
  @@index([organizationId, meetingId])
  @@index([organizationId, status])
  @@map("recording_sessions")
}

/// One signed chunk upload of a recording session (storage key .../sessions/{sessionId}/chunks/{seq}.part).
model RecordingSessionChunk {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("org_id") @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  seq            Int
  sizeBytes      Int       @map("size_bytes")
  sha256         String?
  storageKey     String    @unique @map("storage_key")
  uploadedAt     DateTime? @map("uploaded_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      RecordingSession @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([sessionId, seq])
  @@index([organizationId, sessionId])
  @@map("recording_session_chunks")
}

/// Per-organization AI usage bucket. Incremented atomically (INSERT ... ON CONFLICT DO UPDATE) by
/// incrementAiUsage; never updated through Prisma's update (which would lose concurrent increments).
model AiUsageCounter {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("org_id") @db.Uuid
  provider       String
  periodKind     AiUsagePeriodKind @map("period_kind")
  periodStart    DateTime          @map("period_start") @db.Date
  requests       Int               @default(0)
  inputTokens    BigInt            @default(0) @map("input_tokens")
  outputTokens   BigInt            @default(0) @map("output_tokens")
  audioSeconds   Decimal           @default(0) @map("audio_seconds") @db.Decimal(12, 3)
  costUsd        Decimal           @default(0) @map("cost_usd") @db.Decimal(12, 6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, periodKind, periodStart])
  @@unique([organizationId, id])
  @@map("ai_usage_counters")
}

/// One AI configuration row per organization (PK = FK = org_id). config is a JSON object (CHECK in SQL).
model AiOrganizationConfig {
  organizationId   String   @id @map("org_id") @db.Uuid
  config           Json     @default("{}")
  monthlyBudgetUsd Decimal? @map("monthly_budget_usd") @db.Decimal(12, 2)
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("AiOrganizationConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("ai_org_config")
}

/// Idempotency keys for AI jobs. claimAiIdempotencyKey gives one winner per (org, key); an expired
/// pending claim can be re-claimed.
model AiIdempotency {
  organizationId String              @map("org_id") @db.Uuid
  key            String
  status         AiIdempotencyStatus @default(pending)
  resultRef      String?             @map("result_ref")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime            @map("expires_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@index([expiresAt])
  @@map("ai_idempotency")
}

/// One provider chunk of a chunked transcription. error holds a provider error CODE only (<= 500 chars),
/// never a raw provider response body.
model TranscriptChunk {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("org_id") @db.Uuid
  transcriptId   String                @map("transcript_id") @db.Uuid
  chunkIndex     Int                   @map("chunk_index")
  startMs        Int                   @map("start_ms")
  endMs          Int                   @map("end_ms")
  status         TranscriptChunkStatus @default(pending)
  provider       String
  text           String?
  segments       Json?
  attemptCount   Int                   @default(0) @map("attempt_count")
  error          String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transcript   Transcript   @relation(fields: [organizationId, transcriptId], references: [organizationId, id], onDelete: Cascade)

  @@unique([transcriptId, chunkIndex])
  @@unique([organizationId, id])
  @@index([organizationId, transcriptId])
  @@map("transcript_chunks")
}
