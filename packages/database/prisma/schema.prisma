// Prisma minimal schema for Phase 0
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FileObject {
  id           String   @id @default(cuid())
  key          String   @unique
  bucket       String
  size         Int
  contentType  String?
  checksumSha256 String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
