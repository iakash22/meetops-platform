{
  "name": "@meetops/session-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000"
  },
  "dependencies": {
    "@meetops/contracts": "workspace:*",
    "@meetops/database": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
