#!/usr/bin/env sh
# Fast pre-commit: prettier + NON-type-aware eslint on staged files only.
# Type-aware lint and typecheck run in .husky/pre-push (and in CI).
# If a previous git/hook run was interrupted and git reports
# "Unable to create '.git/index.lock': File exists", ensure no git process
# is running and recover with:  rm -f .git/index.lock
export ESLINT_NO_TYPECHECK=1
pnpm lint-staged
