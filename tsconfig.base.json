{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@meetops/*": ["packages/*/src"],
      "@meetops/contracts": ["packages/contracts/src/index.ts"],
      "@meetops/config": ["packages/config/src/index.ts"],
      "@meetops/logger": ["packages/logger/src/index.ts"],
      "@meetops/queue": ["packages/queue/src/index.ts"],
      "@meetops/storage": ["packages/storage/src/index.ts"],
      "@meetops/ai-core": ["packages/ai-core/src/index.ts"],
      "@meetops/database": ["packages/database/src/index.ts"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "types": ["vitest/globals"]
  },
  "exclude": ["node_modules", "dist", "build", "**/dist", "**/build"]
}
