# MeetOps AI — example environment. Copy to .env for LOCAL DEV.
# Every change-me-local-dev value is a DEV-ONLY placeholder: never reuse it
# outside your machine and never commit a real secret.

# Core
# development|test relax API security (no __Host- cookie prefix, CSRF/Origin
# requirements relaxed, localhost WEB_ORIGINS default). Anything else is strict.
NODE_ENV=development

# API (apps/api, PR #27). The app listens on PORT; API_PORT below is only the
# compose host port mapped to it.
PORT=3000
HOST=0.0.0.0
# Production: required, >= 32 bytes (openssl rand -base64 48). Dev: random per process if empty.
CSRF_SECRET=
# Production: required allowlist for the API Origin/Referer check (not MinIO CORS).
WEB_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma list of proxy IPs/CIDRs; empty = not behind a proxy. `true` is rejected. Hop counts (e.g. 1) are dev/test only
# and fail startup in production (ADR-014).
TRUST_PROXY=
# true only when behind Cloudflare: CF-Connecting-IP is then used from pinned Cloudflare ranges only.
BEHIND_CLOUDFLARE=
# ADR-014 GeoIP: local mmdb only (DB-IP City Lite, CC BY 4.0). dbip | geolite2 | none.
GEOIP_PROVIDER=
GEOIP_DB_PATH=
# Monthly updater (worker): off unless GEOIP_UPDATE_URL and GEOIP_DB_PATH are set. https + allowlisted host only, no redirects.
# e.g. https://download.db-ip.com/free/dbip-city-lite-{YYYY}-{MM}.mmdb.gz
GEOIP_UPDATE_URL=
GEOIP_UPDATE_ALLOWED_HOSTS=
GEOIP_UPDATE_SHA256_URL=
GEOIP_UPDATE_MAX_BYTES=
# Overall download deadline in ms (default 300000).
GEOIP_UPDATE_TOTAL_TIMEOUT_MS=
# Web app base URL (https; localhost allowed in dev). API email links and the worker new-location alert email
# (notifications worker) link to WEB_BASE_URL/settings/sessions. Unset in the worker: alert emails are skipped.
WEB_BASE_URL=

# Database. POSTGRES_* bootstrap the dev container (superuser, dev only).
POSTGRES_USER=meetops
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=meetops
POSTGRES_PORT=5432
# Login passwords for the PR #25 roles, set at first boot by
# infra/compose/postgres/initdb (wipe the postgres-data volume to re-run).
MEETOPS_APP_DB_PASSWORD=change-me-local-dev
MEETOPS_MIGRATOR_DB_PASSWORD=change-me-local-dev
# Prisma / Postgres (port 5432). schema.prisma: url=DATABASE_URL, directUrl=MIGRATION_DATABASE_URL.
# Runtime URL for the API and media worker. Use the meetops_app role (NOBYPASSRLS) outside throwaway local setups.
# Runtime (api/worker): meetops_app, NOSUPERUSER NOBYPASSRLS, DML only.
DATABASE_URL=postgresql://meetops_app:change-me-local-dev@localhost:5432/meetops
# Prisma migrations + seed (directUrl): schema owner meetops_migrator.
MIGRATION_DATABASE_URL=postgresql://meetops_migrator:change-me-local-dev@localhost:5432/meetops
# Optional: superuser URL for `pnpm db:roles` only (compose POSTGRES_USER).
# ADMIN_DATABASE_URL=postgresql://meetops:change-me-local-dev@localhost:5432/postgres

# Redis (compose.dev.yml enables requirepass; keep REDIS_URL in sync). Dev only.
REDIS_PASSWORD=change-me-local-dev
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-dev@localhost:6379
# Bearer token for GET /metrics (>= 32 chars). Unset = endpoint off.
METRICS_TOKEN=
# Per-probe timeout for GET /ready (ms, 100..30000). Default 2000.
READINESS_TIMEOUT_MS=

# Storage (S3-compatible). Dev uses the local MinIO fork; production uses R2/S3.
# true = API upload/recording-session routes use STORAGE_* + Prisma tables and enqueue media jobs on
# BullMQ (needs DATABASE_URL and REDIS_URL).
# Empty/false = in-memory adapters in development/test, media routes off elsewhere.
MEDIA_STORAGE_ENABLED=
# Consent API enforcement. true = upload and recording-session init/chunk/complete require the meeting's latest
# consent event (POST /orgs/:organizationId/meetings/:meetingId/consent) to be a current grant; fails closed
# with 422 CONSENT_* (uploads without a meetingId are refused). Empty/false (default) = off, existing clients unaffected.
CONSENT_ENFORCEMENT_ENABLED=
# Async task -> GitHub/Jira sync route (POST /orgs/:organizationId/tasks/:taskId/sync). Off by default; needs DATABASE_URL + REDIS_URL.
TASK_SYNC_ENABLED=
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=meetops-dev
# Dev-only MinIO root credentials (password >= 8 chars).
STORAGE_ACCESS_KEY_ID=meetops-local
STORAGE_SECRET_ACCESS_KEY=change-me-local-dev
# Scoped app user for the compose stack (created by minio-init, bucket-only policy).
STORAGE_APP_ACCESS_KEY_ID=meetops-app
STORAGE_APP_SECRET_ACCESS_KEY=change-me-local-dev-app
# Empty = default (true for minio, false otherwise).
STORAGE_FORCE_PATH_STYLE=
# Presigned URL TTLs in seconds (1..600).
STORAGE_UPLOAD_TTL_SECONDS=300
STORAGE_DOWNLOAD_TTL_SECONDS=300
# Empty = code defaults (2 GB object, 64 MiB part, 1000 parts, built-in MIME list).
STORAGE_MAX_OBJECT_BYTES=
STORAGE_MAX_PART_BYTES=
STORAGE_MAX_PARTS=
STORAGE_ALLOWED_MIME_TYPES=
# Single browser origin allowed by MinIO CORS (presigned PUT/POST). Not WEB_ORIGINS.
WEB_ORIGIN=http://localhost:5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Realtime gateway (apps/realtime, PR #16).
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4001
REALTIME_CORS_ORIGINS=http://localhost:5173
REALTIME_SOCKET_PATH=/socket.io

# Media tools. Empty = resolve ffmpeg/ffprobe from PATH (works on Windows too).
# The worker image sets /usr/bin/ffmpeg and /usr/bin/ffprobe itself.
FFMPEG_PATH=
FFPROBE_PATH=

# Upload malware scan (worker, ADR-018). true = every upload and recording is streamed to clamd
# (INSTREAM) before processing, fail-closed: an unreachable clamd means retries, then quarantine.
# Production must use true with the clamd sidecar. Compose: start with `--profile clamav`.
UPLOAD_SCAN_CLAMAV=false
# Use CLAMD_SOCKET (unix socket), or CLAMD_HOST + CLAMD_PORT (default 127.0.0.1:3310; compose sets clamav:3310).
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=
# Scan size limits are set in infra/clamav/clamd.conf, not here: StreamMaxLength, MaxFileSize and
# MaxScanSize = 1400M (1_468_006_400 bytes). They must stay >= contracts MAX_MEDIA_BYTES
# (1_400_000_000), so a full-size upload is scanned rather than rejected at the limit.
# apps/worker/test/clamd-config.test.ts checks this.

# Compose host ports / web build
API_PORT=3000
# Vite dev server (pnpm dev)
WEB_PORT=5173
# Containerised nginx web (compose.app.yml); must differ from WEB_PORT
WEB_APP_PORT=8080
# Web → API base URL (baked into the client).
# Local Vite: `/api` (or empty) uses the dev proxy → PORT/API_PORT (same-origin cookies/CSRF).
# Absolute URL (e.g. https://api.example.com) skips the proxy and needs API CORS (WEB_ORIGINS).
# Optional upstream override for the proxy only: VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_API_URL=/api

# Email. Leave EMAIL_PROVIDER, SMTP_HOST and RESEND_API_KEY unset in development to use the in-memory
# console sender (nothing is delivered or logged). Production refuses to start without a provider.
# See docs/08-email/delivery.md.
# Local Mailpit (scripts/dev-services.sh starts it; UI http://localhost:8025, no auth):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# Gmail SMTP (opt-in; needs a Google app password, not the account password):
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# Resend HTTP API (EMAIL_FROM must use a domain verified in Resend):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="MeetOps AI <no-reply@your-verified-domain>"
# Auth mail queue (ADR-013, notifications #11). inline (default) sends in-process; bullmq enqueues ids-only
# jobs on the `auth-mail` BullMQ queue (needs REDIS_URL); the worker sends through the provider EMAIL_PROVIDER
# selects (Mailpit SMTP in dev, Gmail SMTP opt-in, Resend in production), never falling back to another one.
# See docs/08-email/delivery.md.
# AUTH_MAIL_QUEUE=inline
# AUTH_MAIL_QUEUE_PREFIX=
# AUTH_MAIL_WORKER_ENABLED=true
# AUTH_MAIL_WORKER_CONCURRENCY=5

# Desktop PKCE sign-in (ADR-012). Off unless true; the ADR-012 amendment (PR #192) awaits sign-off.
DESKTOP_AUTH_ENABLED=false

# Background workers (apps/worker). All off by default; docs/DEMO_SETUP.md lists what a full demo needs.
# Transcription consumer (needs DATABASE_URL, REDIS_URL and an approved STT provider key below).
TRANSCRIPTION_WORKER_ENABLED=false
TRANSCRIPTION_WORKER_CONCURRENCY=
MEDIA_CHUNK_SECONDS=
# Summary + action items consumer (needs GEMINI_API_KEY). AI_ACTION_ITEMS_ENABLED defaults to true.
AI_SUMMARY_WORKER_ENABLED=false
AI_SUMMARY_WORKER_CONCURRENCY=
AI_ACTION_ITEMS_ENABLED=
# ADR-013 notifications outbox relay + delivery (relay connects with DATABASE_RELAY_URL).
NOTIFICATIONS_WORKER_ENABLED=false
DATABASE_RELAY_URL=
# Integrations token refresh (Jira rotation, GitHub installation tokens). Run on ONE worker replica.
# When true, INTEGRATIONS_TOKEN_KEK (base64 of 32 random bytes, same value in the API and the worker) is
# required or the worker refuses to start. Dev only; production uses the ADR-008 secret manager.
INTEGRATIONS_TOKEN_REFRESH_ENABLED=false
INTEGRATIONS_TOKEN_REFRESH_INTERVAL_MS=
INTEGRATIONS_TOKEN_KEK=

# AI providers
AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
AI_STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
# Worker AssemblyAI adapter (apps/worker/src/ai/providers). Empty = code defaults.
ASSEMBLYAI_BASE_URL=
ASSEMBLYAI_SPEECH_MODEL=
# Optional webhook mode: public https URL + shared header secret (>= 32 random bytes in prod).
ASSEMBLYAI_WEBHOOK_URL=
ASSEMBLYAI_WEBHOOK_SECRET=
AI_TRANSCRIPTION_REQUEST_TIMEOUT_MS=
AI_TRANSCRIPTION_TIMEOUT_MS=
AI_TRANSCRIPTION_POLL_INTERVAL_MS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LOCAL_STT_ENABLED=false
LOCAL_STT_URL=http://localhost:8001
LOCAL_STT_MODEL=Systran/faster-whisper-small
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_ENABLED=false
DEEPGRAM_API_KEY=
AI_ALLOW_PAID_FALLBACK=false
# Worker AI usage/idempotency stores: durable (Postgres, default) | memory (unit tests only; refused in production)
AI_STORES=durable
AI_REQUIRE_PROVIDER_APPROVAL=true

# Integrations (GitHub, Jira, ...) are configured as per-org integration
# options (PR #19), not env vars.

# Phase 3 AI summary (Gemini). Leave GEMINI_API_KEY empty to disable summarization.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
AI_SUMMARY_REQUEST_TIMEOUT_MS=
AI_SUMMARY_MAX_TRANSCRIPT_CHARS=
AI_SUMMARY_MAX_OUTPUT_TOKENS=

# Phase 7 semantic search API (GET /orgs/:org/search/semantic). Off by default: the route is not registered.
# Only the exact value "true" (case-insensitive) turns it on; without a query embedder it answers 503.
SEMANTIC_SEARCH_ENABLED=false

# Integrations, dev only (docs/runbooks/integrations-real-setup.md). Leave unset to keep providers "not configured".
# Production uses an injected runtime (ADR-008 secret manager), not these variables. Never commit values.
# When unset, the API and the worker default to http://localhost:4000 (development/test only). That is NOT the
# API's default PORT (3000 above), so for local OAuth set it explicitly to where the API listens, e.g.:
# INTEGRATIONS_API_ORIGIN=http://localhost:3000
# The worker (token refresh, calendar sync) builds OAuth redirect URIs from INTEGRATIONS_API_ORIGIN. Unless
# NODE_ENV is exactly development or test (so production, staging, unset or anything else) it is REQUIRED there
# (no localhost default; startup fails with a clear error) and must be the bare public https origin of the API:
# INTEGRATIONS_API_ORIGIN=https://api.example.invalid
# INTEGRATIONS_WEB_ORIGIN=http://localhost:5173
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_FILE=./.secrets/github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# Phase 7 Google Calendar (OAuth web client, read-only scopes). Redirect URI to register at Google:
#   ${INTEGRATIONS_API_ORIGIN}/calendar/google/callback
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Phase 7 Outlook Calendar (Microsoft Entra app, delegated Calendars.Read + User.Read + offline_access).
# Redirect URI to register (Web platform): ${INTEGRATIONS_API_ORIGIN}/calendar/outlook/callback
# Setup: docs/04-api/outlook-calendar.md. TENANT: common | organizations | consumers | <tenant GUID>.
# OUTLOOK_CALENDAR_CLIENT_ID=
# OUTLOOK_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_TENANT=common
# Phase 7 calendar background sync (off by default). Worker sweep + API read-through of synced events
# (falls back to a live provider read when the sync is stale or does not cover the requested window).
# CALENDAR_SYNC_ENABLED=false
# CALENDAR_SYNC_INTERVAL_MS=900000
# CALENDAR_SYNC_TICK_MS=60000
# CALENDAR_SYNC_PAST_DAYS=1
# CALENDAR_SYNC_FUTURE_DAYS=30
# CALENDAR_SYNC_BATCH=50
