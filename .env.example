# Core
NODE_ENV=development
# Host port for the API. Compose maps it to the PORT the API listens on (PORT=${API_PORT:-3000}).
API_PORT=3000
PORT=3000

# Database
# Runtime connection (app role). Placeholder local-dev credentials; must match POSTGRES_* in compose.
DATABASE_URL=postgresql://meetops:meetops@localhost:5432/meetops
# Schema-owner connection used by Prisma migrations (directUrl).
MIGRATION_DATABASE_URL=postgresql://meetops:meetops@localhost:5432/meetops

# Redis
REDIS_URL=redis://localhost:6379

# Storage (S3-compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=meetops-dev
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Email (dev: Gmail SMTP via Nodemailer)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MeetOps AI <noreply@example.com>"

# AI
AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
AI_STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_STT_ENABLED=false
LOCAL_STT_URL=http://localhost:8001
OPENAI_ENABLED=false
OPENAI_API_KEY=
DEEPGRAM_ENABLED=false
DEEPGRAM_API_KEY=
AI_ALLOW_PAID_FALLBACK=false
AI_REQUIRE_PROVIDER_APPROVAL=true

# Media tools. Leave empty to resolve ffmpeg/ffprobe from PATH.
# Windows: `winget install Gyan.FFmpeg` or `choco install ffmpeg`, then restart the shell,
# or set a full path, e.g. FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
