# Core
NODE_ENV=development

# Database (compose.dev.yml has no fallbacks: POSTGRES_* are required; local dev placeholders only)
POSTGRES_USER=meetops
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=meetops
POSTGRES_PORT=5432
# Least-privilege login roles (PR #25 RLS), created on first boot of the dev postgres.
MEETOPS_APP_DB_PASSWORD=change-me-app-local-dev
MEETOPS_MIGRATOR_DB_PASSWORD=change-me-migrator-local-dev
# Runtime (api/worker): meetops_app, NOSUPERUSER NOBYPASSRLS, DML only.
DATABASE_URL=postgresql://meetops_app:change-me-app-local-dev@localhost:5432/meetops
# Migrations + seed (prisma directUrl): meetops_migrator, schema owner.
MIGRATION_DATABASE_URL=postgresql://meetops_migrator:change-me-migrator-local-dev@localhost:5432/meetops

# Redis (requirepass is enabled in compose.dev.yml; keep REDIS_URL in sync)
REDIS_PASSWORD=change-me-local-dev
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-dev@localhost:6379

# Storage (S3-compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=meetops-dev
STORAGE_ACCESS_KEY_ID=meetops-local
# MinIO needs >= 8 chars; local dev placeholder only
STORAGE_SECRET_ACCESS_KEY=change-me-local-dev
# Empty = media-core default (true for minio, false otherwise).
STORAGE_FORCE_PATH_STYLE=
STORAGE_PRESIGN_EXPIRES_SECONDS=900
# Upload limits (media-core, PR #10/#39). Empty = code default.
STORAGE_UPLOAD_TTL_SECONDS=600
STORAGE_DOWNLOAD_TTL_SECONDS=300
STORAGE_MAX_OBJECT_BYTES=
STORAGE_MAX_PART_BYTES=
STORAGE_MAX_PARTS=1000
STORAGE_ALLOWED_MIME_TYPES=
# The only browser origin allowed to PUT to the bucket via presigned URLs (minio-init CORS).
# Set to http://localhost:8080 when using the containerised web (WEB_APP_PORT).
WEB_ORIGIN=http://localhost:5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Realtime gateway (apps/realtime, PR #16). Empty CORS origins = allow any (dev only).
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4001
REALTIME_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REALTIME_SOCKET_PATH=/socket.io

# Media (worker)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
MEDIA_TMP_DIR=/tmp/work
MEDIA_WORKER_CONCURRENCY=1
MEDIA_CHUNK_SECONDS=600

# App ports / URLs
API_PORT=3000
# Vite dev server (pnpm dev)
WEB_PORT=5173
# Containerised nginx web (infra/compose/compose.app.yml); must differ from WEB_PORT
WEB_APP_PORT=8080
# API base URL baked into the web build
VITE_API_URL=http://localhost:3000

# Email (dev: Gmail SMTP via Nodemailer)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="MeetOps AI <noreply@example.com>"

# AI
AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
AI_STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LOCAL_STT_ENABLED=false
LOCAL_STT_URL=http://localhost:8000
LOCAL_STT_MODEL=Systran/faster-whisper-small
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_ENABLED=false
DEEPGRAM_API_KEY=
AI_ALLOW_PAID_FALLBACK=false
AI_REQUIRE_PROVIDER_APPROVAL=true

# Integrations (placeholders; set real values only in your local .env)
GITHUB_DEFAULT_REPO=
GITHUB_WEBHOOK_SECRET=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
