# Copy to .env. Placeholders only. Never commit .env.
# One value per key. A later copy of the same key replaces the earlier one.

# App. development and test relax cookie and origin checks.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Empty in dev: a secret is generated per process. Production needs 32+ bytes.
CSRF_SECRET=
WEB_ORIGINS=http://localhost:5173,http://localhost:3000
# Shared by the API and realtime (packages/config/src/client-ip.ts). Empty/false: ignore
# X-Forwarded-For (client IP = socket peer). Comma list of proxy IPs/CIDRs = allowlist.
# "true" and /0 are rejected. A hop count (e.g. 1) is accepted in development/test only and
# fails startup in production. Production realtime behind nginx MUST set an allowlist that
# includes nginx's address (or its network CIDR); compose defaults realtime to hop count 1
# when unset, which production rejects. One TRUST_PROXY feeds both services in compose, so
# trusting a whole docker network CIDR makes the API trust that range too.
# REALTIME_TRUST_PROXY_HOPS was removed; a non-zero value fails realtime startup (set TRUST_PROXY).
TRUST_PROXY=
# true: honour CF-Connecting-IP only when the resolved peer is a pinned Cloudflare edge
# (same rule for API and realtime). Default off.
# Compose passes this to both the API (x-api-env) and realtime. Set true when Cloudflare
# sits in front of the stack; otherwise API rate-limit keys collapse to the CF edge IP.
# See docs/00-getting-started/environment-variables.md and docs/devops/cicd.md.
BEHIND_CLOUDFLARE=
# Links in email. Localhost is allowed in dev.
WEB_BASE_URL=http://localhost:5173
# Google sign-in for the web app (authorization code + PKCE). Leave all three unset to hide the button.
# They must be set together. The redirect URI is the URL the browser hits, and Google Cloud must list it
# exactly. With the Vite /api proxy that is the web origin, not the API port:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# Host ports. API_PORT is published; PORT is what the API process binds.
API_PORT=3000
WEB_PORT=5173
WEB_APP_PORT=8080
# /api uses the Vite proxy. A full https URL skips the proxy and needs WEB_ORIGINS.
VITE_API_URL=/api
# Live updates. Off uses polling. Uncomment the URL to point at apps/realtime.
VITE_REALTIME_ENABLED=false
# VITE_REALTIME_URL=http://localhost:4001
# VITE_REALTIME_PATH=/socket.io

# GeoIP. dbip, geolite2, or none. The updater stays off until both URL and path are set.
GEOIP_PROVIDER=
GEOIP_DB_PATH=
GEOIP_UPDATE_URL=
GEOIP_UPDATE_ALLOWED_HOSTS=
GEOIP_UPDATE_SHA256_URL=
GEOIP_UPDATE_MAX_BYTES=
GEOIP_UPDATE_TOTAL_TIMEOUT_MS=

# Database: local Docker. App role is meetops_app; migrations use meetops_migrator.
POSTGRES_USER=meetops
POSTGRES_PASSWORD=change-me-local-dev
POSTGRES_DB=meetops
POSTGRES_PORT=5432
MEETOPS_APP_DB_PASSWORD=change-me-local-dev
MEETOPS_MIGRATOR_DB_PASSWORD=change-me-local-dev
DATABASE_URL=postgresql://meetops_app:change-me-local-dev@localhost:5432/meetops
MIGRATION_DATABASE_URL=postgresql://meetops_migrator:change-me-local-dev@localhost:5432/meetops
# Uncomment for pnpm db:roles. Points at the local superuser, not the app role.
# ADMIN_DATABASE_URL=postgresql://meetops:change-me-local-dev@localhost:5432/postgres
# Neon. Comment the local URLs above and uncomment these. Pooled URL is for the app; direct URL is for migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&pgbouncer=true
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require
# ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech:5432/DB?sslmode=require&channel_binding=require

# Redis: local Docker. The password in REDIS_URL must match REDIS_PASSWORD.
REDIS_PASSWORD=change-me-local-dev
REDIS_PORT=6379
REDIS_URL=redis://:change-me-local-dev@localhost:6379
# Layerbase. Comment the local URL above and uncomment this. rediss:// means TLS.
# REDIS_URL=rediss://default:PASSWORD@HOST.cloud.layerbase.dev:6379

# API extras. Empty metrics token turns /metrics off. Docs are on in development.
METRICS_TOKEN=
API_DOCS_ENABLED=
API_DOCS_ADMIN_EMAILS=
READINESS_TIMEOUT_MS=

# Storage: minio (local Docker), neon, r2, or s3. Path-style is automatic for minio and neon.
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=meetops-dev
STORAGE_ACCESS_KEY_ID=meetops-local
STORAGE_SECRET_ACCESS_KEY=change-me-local-dev
# MinIO app user created by minio-init. Not used by the Neon provider.
STORAGE_APP_ACCESS_KEY_ID=meetops-app
STORAGE_APP_SECRET_ACCESS_KEY=change-me-local-dev-app
STORAGE_FORCE_PATH_STYLE=
STORAGE_UPLOAD_TTL_SECONDS=300
STORAGE_DOWNLOAD_TTL_SECONDS=300
STORAGE_MAX_OBJECT_BYTES=
STORAGE_MAX_PART_BYTES=
STORAGE_MAX_PARTS=
STORAGE_ALLOWED_MIME_TYPES=
# Browser origin allowed to upload straight to the bucket.
WEB_ORIGIN=http://localhost:5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Neon Object Storage. Comment the minio endpoint, region, bucket, and keys above, then uncomment these.
# STORAGE_PROVIDER=neon
# STORAGE_ENDPOINT=https://BRANCH.storage.REGION.aws.neon.tech
# STORAGE_REGION=us-east-2
# STORAGE_BUCKET=meetops
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# true: upload routes use STORAGE_* plus the database and Redis. Empty keeps dev in memory.
MEDIA_STORAGE_ENABLED=
# true: uploads require a current meeting consent grant.
CONSENT_ENFORCEMENT_ENABLED=
# true: approved tasks can be pushed to GitHub or Jira. Needs the database and Redis.
TASK_SYNC_ENABLED=

# Realtime gateway. Client IP uses TRUST_PROXY / BEHIND_CLOUDFLARE (same parser as API).
# Compose passes BEHIND_CLOUDFLARE to both API and realtime; see comment above.
# Do not set REALTIME_TRUST_PROXY_HOPS (removed; non-zero fails startup).
REALTIME_HOST=0.0.0.0
REALTIME_PORT=4001
REALTIME_CORS_ORIGINS=http://localhost:5173
REALTIME_SOCKET_PATH=/socket.io

# Empty: use ffmpeg and ffprobe from PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# true: scan uploads with clamd before processing. Start the clamav compose profile with it.
UPLOAD_SCAN_CLAMAV=false
CLAMD_SOCKET=
CLAMD_HOST=
CLAMD_PORT=

# Email. Leave the provider empty in dev to print mail instead of sending it.
# Gmail needs an app password. Resend needs a verified domain. See docs/08-email/delivery.md.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="MeetOps AI <no-reply@your-verified-domain>"
# inline sends in the API process. bullmq sends through Redis.
# AUTH_MAIL_QUEUE=inline
# AUTH_MAIL_QUEUE_PREFIX=
# AUTH_MAIL_WORKER_ENABLED=true
# AUTH_MAIL_WORKER_CONCURRENCY=5

# Desktop sign-in. Off until explicitly enabled.
DESKTOP_AUTH_ENABLED=false

# Workers. All off until you enable one. See docs/DEMO_SETUP.md.
TRANSCRIPTION_WORKER_ENABLED=false
TRANSCRIPTION_WORKER_CONCURRENCY=
MEDIA_CHUNK_SECONDS=
AI_SUMMARY_WORKER_ENABLED=false
AI_SUMMARY_WORKER_CONCURRENCY=
AI_ACTION_ITEMS_ENABLED=
NOTIFICATIONS_WORKER_ENABLED=false
DATABASE_RELAY_URL=
# true also requires INTEGRATIONS_TOKEN_KEK (base64 of 32 bytes) in the API and the worker.
INTEGRATIONS_TOKEN_REFRESH_ENABLED=false
INTEGRATIONS_TOKEN_REFRESH_INTERVAL_MS=
INTEGRATIONS_TOKEN_KEK=

# AI. Leave a key empty to keep that provider off.
AI_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=
AI_STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=
ASSEMBLYAI_SPEECH_MODEL=
ASSEMBLYAI_WEBHOOK_URL=
ASSEMBLYAI_WEBHOOK_SECRET=
AI_TRANSCRIPTION_REQUEST_TIMEOUT_MS=
AI_TRANSCRIPTION_TIMEOUT_MS=
AI_TRANSCRIPTION_POLL_INTERVAL_MS=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LOCAL_STT_ENABLED=false
LOCAL_STT_URL=http://localhost:8001
LOCAL_STT_MODEL=Systran/faster-whisper-small
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_ENABLED=false
DEEPGRAM_API_KEY=
AI_ALLOW_PAID_FALLBACK=false
# durable uses Postgres. memory is for unit tests and is refused in production.
AI_STORES=durable
AI_REQUIRE_PROVIDER_APPROVAL=true
AI_SUMMARY_REQUEST_TIMEOUT_MS=
AI_SUMMARY_MAX_TRANSCRIPT_CHARS=
AI_SUMMARY_MAX_OUTPUT_TOKENS=
# true registers semantic search. Without an embedder the route returns 503.
SEMANTIC_SEARCH_ENABLED=false

# Integrations. Per-org options, not required for local dev. Production does not read these.
# INTEGRATIONS_API_ORIGIN=http://localhost:3000
# INTEGRATIONS_WEB_ORIGIN=http://localhost:5173
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_FILE=./.secrets/github-app.pem
# GITHUB_APP_WEBHOOK_SECRET=
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_CLIENT_ID=
# OUTLOOK_CALENDAR_CLIENT_SECRET=
# OUTLOOK_CALENDAR_TENANT=common
# CALENDAR_SYNC_ENABLED=false
# CALENDAR_SYNC_INTERVAL_MS=900000
# CALENDAR_SYNC_TICK_MS=60000
# CALENDAR_SYNC_PAST_DAYS=1
# CALENDAR_SYNC_FUTURE_DAYS=30
# CALENDAR_SYNC_BATCH=50
# CALENDAR_AUTO_LINK_ENABLED=false
